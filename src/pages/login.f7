              </div>
            </li>
          </ul>
        </div>
        <div class="block">
          <button type="submit" class="button button-fill login-button">
            Sign In
          </button>
        </div>
      </form>
      <div class="block text-align-center">
        <a href="/register/">Create an account?</a>
      </div>
    </div>
  </div>
</template>


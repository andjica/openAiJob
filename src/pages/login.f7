<template>
  <div class="page" data-name="login">
    <div class="page-content">
      <div class="login-screen-title">
        <img src="./assets/images/logo1.png" width="150px" />
      </div>

      <form id="loginForm" class="list no-hairlines-md">
        <ul class="inset">
          <li class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">Email</div>
              <div class="item-input-wrap">
                <input id="emailInput" type="email" placeholder="Your email" />
                <span class="input-clear-button"></span>
              </div>
            </div>
          </li>
          <li class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">Password</div>
              <div class="item-input-wrap">
                <input
                  id="passwordInput"
                  type="password"
                  placeholder="Your password"
                />
                <span class="input-clear-button"></span>
              </div>
            </div>
          </li>
        </ul>
        <div class="block">
            <button type="submit" class="button button-fill login-button">
              Sign In
            </button>
          </div>
      </form>
      <div class="block text-align-center">
        <a href="/register/">Create an account?</a>
      </div>
    </div>
  </div>
</template>

<style>
    .login-screen-title{
        margin-top: 50%;
        height: 10%;
    }
  .login-screen-content .list {
    max-width: 350px;
    margin: 0 auto;
  }
  .login-screen-content .item-input-wrap input {
    width: 100%; /* inputi preuzimaju širinu list-e */
    box-sizing: border-box;
  }
  .login-screen-content .item-input-wrap input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #9fa1f1; /* sivi border */
    border-radius: 5px;
    padding: 8px; /* unutrašnji razmak za udobno kucanje */
  }
  .login-button {
    border-radius: 5px;
    max-width: 150px;
    margin: 0 auto;
  }
</style>

<script>
    export default (props, { $, $on, $f7, $f7router }) => {
      $on("pageInit", () => {
        const $email = $("#emailInput");
        const $password = $("#passwordInput");
    
        function validateEmail(email) {
          const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          return re.test(email);
        }
    
        $("#loginForm").on("submit", (e) => {
          e.preventDefault();
          const email = $email.val().trim();
          const password = $password.val();
          const errors = [];
    
          if (!email) {
            errors.push("Email is required!");
          } else if (!validateEmail(email)) {
            errors.push("Email is not valid!");
          }
          if (!password) {
            errors.push("Password is required");
          } else if (password.length < 6) {
            errors.push("Password must be at least 6 characters");
          }
    
          if (errors.length) {
            const msgHtml = errors.map((msg) => `<div>${msg}</div>`).join("");
            $f7.dialog.alert(msgHtml, "Validation Errors");
            return;
          }

          // const doLogin = () => loginUser(email, password); // da se posle doda device_token
        // if (window.FirebasePlugin) {
        //   window.FirebasePlugin.getToken(
        //     (token) => {
        //       console.log("Device token:", token);
        //       doLogin();
        //     },
        //     (err) => {
        //       console.warn("Token error", err);
        //       doLogin();
        //     }
        //   );
        // } else {
        //   doLogin();
        // }
    
          loginUser(email, password);
        });
    
        function loginUser(email, password) {
          $f7.dialog.preloader("Logging in...");
          fetch("http://127.0.0.1:8000/api/login", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Accept: "application/json",
            },
            body: JSON.stringify({ email, password }),
          })
            .then((response) => {
              if (!response.ok) throw new Error(`HTTP ${response.status}`);
              return response.json();
            })
            .then((data) => {
              $f7.dialog.close();
              if (data.token) {
                localStorage.setItem("jwt_token", data.token);
                localStorage.setItem("candidatProfile", JSON.stringify(data.user));
                $f7router.navigate('/home/');
              } else {
                $f7.dialog.alert(data.message || "Invalid credentials.");
              }
            })
            .catch((err) => {
              $f7.dialog.close();
              console.error("Login error", err);
              $f7.dialog.alert("Error: " + err.message);
            });
        }
      });
    
      return $render;
    };
    </script>
    

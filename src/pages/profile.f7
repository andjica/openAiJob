<template>
  <div class="page" data-name="setting">
    <div class="navbar navbar-large">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a id="backLink" href="#" class="link back">
            <i class="icon icon-back"></i>
          </a>
        </div>
        <div class="title-large setting__title">
          <div class="title-large-text" id="profileTitle">Profile</div>
        </div>
      </div>
    </div>
    <div class="page-content pt-60">
      <form
        class="form-block mb-40"
        id="verifyProfileForm"
        enctype="multipart/form-data"
      >
        <!-- Personal Information -->
        <h4>Personal Information</h4>
        <div class="list">
          <ul>
            <li>
              <div class="list no-hairlines-md">
                <div class="item-content item-input">
                  <div class="item-inner">
                    <label class="item-title">Full Name</label>
                    <div class="item-input-wrap">
                      <input
                        type="text"
                        placeholder="Enter your full name"
                        id="full-name"
                        name="full_name"
                        class="fontSize-18"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Email</label>
                  <div class="item-input">
                    <input
                      type="email"
                      placeholder="Enter your email"
                      id="email"
                      name="email"
                      class="fontSize-18"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content content-flex item-select item-input">
                <a
                  class="item-link smart-select smart-select-init w-100"
                  data-open-in="sheet"
                >
                  <select name="country" id="countries" data-open-in="sheet">
                    <option value="">Select a country</option>
                  </select>
                  <div class="select-content">
                    <div for="countries" class="item-title w-20">Country</div>
                  </div>
                </a>
              </div>
              <div class="item-content content-flex item-select item-input">
                <a
                  class="item-link smart-select smart-select-init w-100"
                  data-open-in="sheet"
                >
                  <select name="city" id="cities">
                    <option value="">Select a city</option>
                  </select>
                  <div class="select-content">
                    <label for="cities" class="item-title">City</label>
                  </div>
                </a>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Phone</label>
                  <div class="item-media">
                    <span id="phone-code">XXX</span>
                    <input
                      type="tel"
                      placeholder="Enter your phone number"
                      name="phone_number"
                      id="phoneNumber"
                      inputmode="numeric"
                      class="ml-5 fontSize-18"
                      maxlength="10"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <label class="item-title">Birthday</label>
                <div class="item-input">
                  <div class="item-media">
                    <input type="date" id="user_birthday" />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-inner btn-upload">
                <label for="profile_image" class="custom-file-upload"
                  >Upload Image</label
                >
                <input type="file" id="profile_image" accept="image/*" hidden />
                <span
                  id="profile_filename"
                  style="font-size: 12px; color: #555"
                ></span>
              </div>
            </li>
          </ul>
        </div>
        <!-- Professional Experience -->
        <h4>Professional Experience</h4>
        <div class="list">
          <ul>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Current Title</label>
                  <div class="item-input">
                    <input
                      type="text"
                      placeholder="Enter your job title"
                      id="current_title_job"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Current Company</label>
                  <div class="item-input">
                    <input
                      type="text"
                      placeholder="Enter your company name"
                      id="current_company"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Years of Experience</label>
                  <div class="item-input">
                    <input
                      type="text"
                      placeholder="Enter years of experience"
                      id="years_of_experience"
                    />
                  </div>
                </div>
              </div>
            </li>
          </ul>
        </div>
        <!-- Education -->
        <h4>Education</h4>
        <div class="list">
          <ul>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Name</label>
                  <div class="item-input">
                    <input
                      type="text"
                      placeholder="Enter your schoole name"
                      id="school_name"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Degree</label>
                  <div class="item-input">
                    <input
                      type="text"
                      placeholder="Enter your degree"
                      id="school_degree"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Start Year</label>
                  <div class="item-input">
                    <input
                      type="number"
                      placeholder="Enter your start year"
                      id="school_year_start"
                      min="1950"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Graduation Year</label>
                  <div class="item-input">
                    <input
                      type="number"
                      placeholder="Enter your graduation year"
                      id="school_year_end"
                      min="1950"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-inner btn-upload">
                <label for="cv_upload" class="custom-file-upload"
                  >Upload CV</label
                >
                <input
                  type="file"
                  id="cv_upload"
                  accept=".pdf,.doc,.docx"
                  hidden
                />
                <span
                  id="cv_filename"
                  style="font-size: 12px; display: block; margin-top: 5px"
                ></span>
              </div>
            </li>
          </ul>
        </div>
        <button type="submit" class="button button-fill-1">SUBMIT</button>
      </form>
      <button class="button button-fill-2 logout">Logout</button>
    </div>
  </div>
</template>

<style>
  .form-block > h4 {
    padding-left: 18px;
  }
  .setting__title {
    position: static !important;
    width: 100%;
    margin-left: 60px;
  }

  .file-input {
    margin-top: 10px;
  }

  .list {
    margin-bottom: 20px;
  }

  .list .item-content {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: calc(var(--f7-list-item-min-height));
    width: 90%;
    margin: 0px auto;
    border-radius: 20px;
    margin-top: 10px;
  }

  .btn-upload {
    flex-direction: column !important;
    justify-content: center !important;
  }
  .btn-upload .custom-file-upload {
    background-color: #007aff;
    border: none;
    border-radius: 5px;
    padding: 10px;
    color: white;
  }
  .list .item-link {
    display: block;
    padding-top: 9px;
    text-align: left;
  }

  .item-content.item-input {
    background-color: transparent !important;
  }
  .item-title {
    position: absolute;
    background: white;
    padding: 0 2px;
  }

  .item-content .form_select-control {
    width: 100%; /* Make it responsive */
    height: auto;
    background-color: transparent !important;
    padding: 5px 0;
    font-size: 16px;
    font-weight: bold;
    color: #333; /* Text color */
    outline: none;
    cursor: pointer;
  }

  .item-content select {
    top: 0 !important;
    text-align: left;
  }

  /* Styling the dropdown options */
  .item-content .form_select-control option {
    background-color: #fff;
    color: #333;
    font-size: 16px;
    padding: 5px;
  }

  .item-radio .item-inner {
    padding-top: 0;
    padding-bottom: 5px;
    align-items: flex-end;
  }

  .select-content .item-after {
    font-size: 18px;
    text-align: left;
  }

  .button-fill-1 {
    width: 100%;
    background-color: #007aff;
    border: none;
    border-radius: 5px;
    padding: 10px;
    color: white;
    font-size: 16px;
  }

  .button-fill-1:hover {
    background-color: #005bb5;
  }

  .button-fill-2 {
    width: 100%;
    background-color: #ec3838;
    border: none;
    border-radius: 5px;
    padding: 10px;
    color: white;
    font-size: 16px;
  }

  .button-fill-2:hover {
    background-color: #f12626;
  }

  .smart-select .item-after {
    max-width: 100%;
  }

  .sheet-modal {
    height: 500px;
  }

  select#font-family {
    position: relative;
    top: 0px;
    background: none !important;
    font-weight: bold;
    float: right;
    right: -41px;
  }

  /* Input text field inside your styled list */
  .item-content.item-input input[type="text"] {
    width: 100%;
    padding: 10px 35px 10px 10px;
    font-size: 18px;
    font-weight: 500;
    border: none;
    background: transparent;
    color: #333;
    outline: none;
  }

  input[type="number"] {
    font-size: 18px;
    font-weight: 500;
  }

  /* Label styling (already styled but enhanced) */
  .item-title {
    position: absolute;
    top: -10px;
    left: 15px;
    background: white;
    padding: 0 4px;
    font-size: 14px;
    color: #007aff;
    font-weight: 600;
  }

  .message_required::first-letter {
    text-transform: uppercase;
  }
</style>
<script>
  export default (props, { $, $f7, $on, $f7router }) => {
    $on("pageInit", async () => {
      let candidatProfile = null;

      ///kada se inicijalizuje stranica ispitati dal candit popunio podatke
      const user = JSON.parse(localStorage.getItem("user"));
      const jwtToken = localStorage.getItem("jwt_token");
      fetch(`http://127.0.0.1:8000/api/candidat/${user.id}`, {
        method: "GET",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
          Authorization: `Bearer ${jwtToken}`,
        },
      })
        .then((response) => {
          if (!response.ok) {
            throw new Error("Network response was not ok");
          }
          return response.json();
        })
        .then((data) => {
          if (data.candidateProfile.is_finished_profile == 1) {
            console.log("DA LI JE UZEO ", data.candidateProfile);

            localStorage.setItem(
              "candidatProfile",
              JSON.stringify(data.candidateProfile)
            );
            const candidatProfile = JSON.parse(
              localStorage.getItem("candidatProfile")
            );
            console.log("andjica", candidatProfile);

            try {
            } catch (e) {
              console.error("Invalid JSON in localStorage[candidatProfile]", e);
            }

            // Continue safely with your field population code...
            $("#full-name").val(
              `${candidatProfile.user.first_name || ""} ${
                candidatProfile.user.last_name || ""
              }`
            );
            $("#email").val(candidatProfile.user.email || "");
            $("#phoneNumber").val(candidatProfile.phone || "");
            $("#user_birthday").val(candidatProfile.birthday || "");

            const fullPhone = candidatProfile.phone || "";
            const countryCode = candidatProfile.country?.phone_code || "";
            const localPhone = fullPhone.replace(
              new RegExp(`^\\+?${countryCode}`),
              ""
            );
            $("#phoneNumber").val(localPhone);
            $("#phone-code").text(`+${countryCode}`);

            if (candidatProfile.profile_image) {
              $("#profile_image_preview").attr(
                "src",
                candidatProfile.profile_image
              );
            }

            $("#current_company").val(candidatProfile.current_company || "");
            $("#current_title_job").val(
              candidatProfile.current_title_job || ""
            );
            $("#years_of_experience").val(
              candidatProfile.years_of_experience || ""
            );

            $("#school_name").val(candidatProfile.school_name || "");
            $("#school_degree").val(candidatProfile.school_degree || "");
            $("#school_year_start").val(
              candidatProfile.school_year_start || ""
            );
            $("#school_year_end").val(candidatProfile.school_year_end || "");
            console.log("CV", candidatProfile.cv);
            // const $cvInput = $("#cv_upload");
            // if ($cvInput.length && candidat.cv) {
            //   $cvInput.after(
            //     `<a href="${data.data.cv}" target="_blank">View Uploaded CV</a>`
            //   );
            // }
          } else {
            alert("0 novo ");
            candidatProfile = localStorage.setItem("candidatProfile", 0);
            fetchCountry();
            fetchCity();  
          }
        })
        .catch((error) => {
          console.error("Fetch error:", error);
          $f7.dialog.alert("Something wrong to fetch", "Error");
        });

      const backLink = document.getElementById("backLink");
      const profileTitle = document.getElementById("profileTitle");
      // Check if candidatProfile is 0
      if (candidatProfile === 0) {
        backLink.style.display = "none"; // Hide the element
      } else {
        backLink.style.display = "block"; // Show the element (in case it was hidden)
      }

      if (candidatProfile) {
        profileTitle.textContent = "Your Profile";
      } else {
        profileTitle.textContent = "Finish Profile";
      }

      // Ensure phone number only contains digits as the user types
      const phoneInput = document.getElementById("phoneNumber");
      if (phoneInput) {
        phoneInput.addEventListener("input", function () {
          this.value = this.value.replace(/[^0-9]/g, "");
        });
      }

      if (user) {
        const fullName = `${user.first_name} ${user.last_name}`;
        const fullNameInput = document.getElementById("full-name");
        const email = `${user.email}`;
        const emailInput = document.getElementById("email");

        if (fullNameInput || emailInput) {
          fullNameInput.value = fullName;
          emailInput.value = email;
        }
      }

      const countriesData = localStorage.getItem("countriesData");
      const profileData = localStorage.getItem("user");

      const profileInput = document.getElementById("profile_image");
      const cvInput = document.getElementById("cv_upload");

      if (profileInput) {
        profileInput.addEventListener("change", function () {
          const file = this.files[0];
          const fileNameSpan = document.getElementById("profile_filename");
          if (file && fileNameSpan) {
            fileNameSpan.textContent = file.name;
          }
        });
      }

      if (cvInput) {
        cvInput.addEventListener("change", function () {
          const file = this.files[0];
          const fileNameSpan = document.getElementById("cv_filename");
          if (file && fileNameSpan) {
            fileNameSpan.textContent = file.name;
          }
        });
      }

      await fetchCountry();

      $("#verifyProfileForm").on("submit", (e) => {
        e.preventDefault();
        submitProfile(e);
      });

      const submitProfile = async (event) => {
        let isValid = true;
        const errors = [];

        const userData = localStorage.getItem("user");
        const user = userData ? JSON.parse(userData) : null;
        const token = localStorage.getItem("jwt_token");

        const profileInput = document.getElementById("profile_image");
        const profileFile = profileInput?.files?.[0] || null;

        const cvInput = document.getElementById("cv_upload");
        const cvFile = cvInput?.files?.[0] || null;

        // List of required fields
        const requiredFields = [
          "full-name",
          "email",
          "phoneNumber",
          "cities",
          "current_title_job",
          "current_company",
          "years_of_experience",
          "school_degree",
          "school_name",
          "school_year_start",
          "school_year_end",
          "cv_upload",
        ];

        // Validate each field
        requiredFields.forEach((id) => {
          const input = document.getElementById(id);
          if (!input) {
            console.error(`Element with id '${id}' not found.`);
            return;
          }

          const value =
            input.type === "file" ? input.files[0] : input.value.trim();

          if (id === "years_of_experience") {
            if (
              !/^\d{1,2}$/.test(value) ||
              parseInt(value) < 1 ||
              parseInt(value) > 99
            ) {
              errors.push("Experience must be a number between 1 and 99.");
              isValid = false;
            }
          } else if (id === "phoneNumber") {
            const phoneValue = value;
            const regex = /^[0-9]*$/;
            if (!regex.test(phoneValue)) {
              errors.push("Phone number must contain only digits.");
              isValid = false;
            }
          } else if (id === "school_year_start" || id === "school_year_end") {
            if (!/^\d{4}$/.test(value)) {
              errors.push("School years must be 4-digit numbers.");
              isValid = false;
            }
          } else if (id === "cv_upload") {
            if (!value) {
              errors.push("CV is required.");
              isValid = false;
            } else if (value.size > 5 * 1024 * 1024) {
              errors.push("CV file must be 5MB or smaller.");
              isValid = false;
            }
          } else if (id === "profile_image") {
            if (!profileFile) {
              errors.push("Profile image is required.");
              isValid = false;
            } else if (profileFile.size > 5 * 1024 * 1024) {
              errors.push("Profile image must be 5MB or smaller.");
              isValid = false;
            }
          } else {
            if (!value) {
              errors.push(`${id.replace(/_/g, " ")} is required.`);
              isValid = false;
            }
          }
        });

        // Show all collected errors if any
        if (!isValid) {
          const msgHtml = errors
            .map(
              (msg) =>
                `<div>• <span class="message_required">${msg}</span></div>`
            )
            .join("");
          $f7.dialog.alert(msgHtml, "Validation Errors");
          return;
        }

        const fullName = $("#full-name").val().trim();
        const [firstName, ...rest] = fullName.split(" ");
        const lastName = rest.join(" ");

        const phoneCode = $("#phone-code").text().trim();
        const phoneNumber = $("#phoneNumber").val().trim();
        const fullPhone = phoneCode + phoneNumber;

        const formData = new FormData();
        formData.append("user_id", user?.id);
        formData.append("first_name", firstName);
        formData.append("last_name", lastName);
        formData.append("country_id", $("#countries").val());
        formData.append("city_id", $("#cities").val());
        formData.append("birthday", $("#user_birthday").val());
        formData.append("phone", fullPhone);
        formData.append("current_company", $("#current_company").val());
        formData.append("current_title_job", $("#current_title_job").val());
        formData.append("years_of_experience", $("#years_of_experience").val());
        formData.append("school_name", $("#school_name").val());
        formData.append("school_degree", $("#school_degree").val());
        formData.append("school_year_start", $("#school_year_start").val());
        formData.append("school_year_end", $("#school_year_end").val());

        if (profileFile) formData.append("profile_image", profileFile);
        if (cvFile) formData.append("cv", cvFile);
        console.log("FORM DATA: ", formData);
        const preloader = $f7.dialog.preloader("Updating...");
        try {
          const url = `http://127.0.0.1:8000/api/candidat/profile/update/${user.id}`;
          const response = await fetch(url, {
            method: "POST",
            headers: {
              Authorization: `Bearer ${token}`,
            },
            body: formData,
          });
          if (response.ok) {
            const data = await response.json();
            console.log("PODACI",data);
            localStorage.setItem("candidatProfile", JSON.stringify(data.original.data));
            $f7.dialog.close();
            $f7router.navigate("/main/");
          } else {
            console.log(response.message);
            throw new Error("Failed to save user profile!");
          }
        } catch (error) {
          console.error("Error:", error);
          $f7.dialog.close();
          $f7.dialog.alert(
            "Something went wrong while submitting the profile.",
            "Error"
          );
        }
      };

      $(".logout").on("click", function () {
        localStorage.removeItem("jwt_token");
        localStorage.removeItem("user");
        localStorage.removeItem("userVerify");
        localStorage.removeItem("userId");
        $f7router.navigate("/login/");
      });
    });

    const fetchCountry = async () => {
      try {
        const token = localStorage.getItem("jwt_token");

        if (!token) throw new Error("Token not found! Please log in.");

        const profileData = JSON.parse(localStorage.getItem("candidatProfile"));
        let selectedCountryId = "";

        if (profileData) {
          try {
            const countryData = profileData;
            selectedCountryId = countryData?.country?.id || "";
          } catch (err) {
            console.warn("Could not extract country ID from profile data.");
          }
        }
        else if(profileData === "0"){

        }

        const storedCountries = localStorage.getItem("countriesData");
        if (storedCountries) {
          populateCountriesDropdown(
            JSON.parse(storedCountries),
            selectedCountryId
          );
          return;
        }

        const url = `http://127.0.0.1:8000/api/countries`;
        const response = await fetch(url, {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
            Authorization: `Bearer ${token}`,
          },
        });

        if (!response.ok) throw new Error("Failed to fetch countries!");

        const data = await response.json();
        const countries = Array.isArray(data) ? data : data?.countries;

        if (!Array.isArray(countries))
          throw new Error("Countries data is not an array!");

        localStorage.setItem("countriesData", JSON.stringify(countries));
        populateCountriesDropdown(countries, selectedCountryId);
      } catch (error) {
        console.error("Error:", error.message);
      }
    };

    const populateCountriesDropdown = (countries, selectedCountryId = "") => {
      const countrySelect = $("#countries");
      countrySelect.empty();

      // Add default option
      countrySelect.append('<option value="">Select a country</option>');

      // Sort: selected one first (after default), rest follow
      const sortedCountries = [
        ...countries.filter((c) => c.id == selectedCountryId),
        ...countries.filter((c) => c.id != selectedCountryId),
      ];

      sortedCountries.forEach((c) => {
        countrySelect.append(
          `<option value="${c.id}" ${
            c.id == selectedCountryId ? "selected" : ""
          }>${c.name}</option>`
        );
      });

      // Reinit Smart Select
      const ssEl = document.querySelector(".smart-select");
      if (ssEl?.f7SmartSelect) ssEl.f7SmartSelect.destroy();

      const app = Framework7?.instance || new Framework7();
      app.smartSelect.create({ el: ".smart-select" });

      if (selectedCountryId) {
        fetchPhone(selectedCountryId);
        fetchCity(selectedCountryId);
      }

      countrySelect.off("change").on("change", function () {
        const selectedId = $(this).val();
        if (selectedId) {
          alert(selectedId);
          fetchPhone(selectedId);
          fetchCity(selectedId);
        } else {
          $("#phone-code").text("XXX");
          $("#cities").html('<option value="">Select a city</option>');
        }
      });
    };

    const fetchCity = async (countryId, selectedCityId = "") => {
      try {
        const token = localStorage.getItem("jwt_token");

        if (!token) {
          throw new Error("Token not found! Please log in.");
        }

        // Get selectedCityId from candidatProfile
        const profileData = JSON.parse(localStorage.getItem("candidatProfile"));
        let selectedCityIdFromProfile = "";
        if (profileData) {
          try {
            const cityData = profileData;
            selectedCityIdFromProfile = cityData.city?.id || "";
          } catch (err) {
            console.warn("Could not extract city ID from profile data.");
          }
        }

        // Use selectedCityId from profile data or the passed selectedCityId
        selectedCityId = selectedCityId || selectedCityIdFromProfile;

        // Check if cities data is stored in localStorage
        const storedCities = localStorage.getItem(`citiesData-${countryId}`);
        if (storedCities) {
          populateCitiesDropdown(JSON.parse(storedCities), selectedCityId);
          return;
        }

        // Fetch cities from the API
        const url = `http://127.0.0.1:8000/api/cities/${countryId}`;
        const response = await fetch(url, {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
            Authorization: `Bearer ${token}`,
          },
        });

        if (!response.ok) {
          throw new Error("Failed to fetch cities!");
        }

        const data = await response.json();
        const cities = Array.isArray(data) ? data : data.cities;

        if (!Array.isArray(cities)) {
          throw new Error("Cities data is not an array!");
        }

        // Store cities in localStorage for future use
        localStorage.setItem(`citiesData-${countryId}`, JSON.stringify(cities));

        // Populate the dropdown
        populateCitiesDropdown(cities, selectedCityId);
      } catch (error) {
        console.error("Error:", error);
        $("#cities").html('<option value="">Select a city</option>');
      }
    };

    // Function to populate the cities dropdown
    const populateCitiesDropdown = (cities, selectedCityId = "") => {
      const citySelect = $("#cities");
      citySelect.empty();

      // Add default option
      citySelect.append('<option value="">Select a city</option>');

      // Sort: selected one first (after default), rest follow
      const sortedCities = [
        ...cities.filter((c) => c.id == selectedCityId),
        ...cities.filter((c) => c.id != selectedCityId),
      ];

      sortedCities.forEach((c) => {
        citySelect.append(
          `<option value="${c.id}" ${
            c.id == selectedCityId ? "selected" : ""
          }>${c.name}</option>`
        );
      });

      const ssEl = document.querySelector("#cities");
      if (ssEl?.f7SmartSelect) ssEl.f7SmartSelect.destroy();

      const app = Framework7?.instance || new Framework7();
      app.smartSelect.create({ el: "#cities" });

      citySelect.off("change").on("change", function () {
        const selectedId = $(this).val();
        if (selectedId) {
          console.log(`City selected: ${selectedId}`);
        } else {
          console.log("No city selected");
          $("#city-details").html("");
        }
      });
    };

    //phone phone code
    const fetchPhone = async (countryId) => {
      try {
        const url = `http://127.0.0.1:8000/api/country/${countryId}/phone-code`;
        const response = await fetch(url, {
          method: "GET",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
        });

        if (!response.ok) {
          throw new Error("Failed to fetch phone code!");
        }

        const data = await response.json();

        // Display phone code
        $("#phone-code").text(data.phone ? `+${data.phone}` : "XXX");
      } catch (error) {
        console.error("Error:", error);
      }
    };

    return $render;
  };
</script>

<template>
  <div class="page" data-name="profile">
    <div class="navbar navbar-large">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a id="backLink" href="/main/" class="link back">
            <i class="icon icon-back"></i>
          </a>
        </div>
        <div class="title-large setting__title">
          <div class="title-large-text pl-0" id="profileTitle">Profile</div>
        </div>
      </div>
    </div>
    <div class="page-content pt-60">
      <form
        class="form-block mb-40"
        id="verifyProfileForm"
        enctype="multipart/form-data"
      >
        <!-- Personal Information -->
        <h4>Personal Information</h4>
        <div class="list">
          <ul>
            <li>
              <div class="list no-hairlines-md">
                <div class="item-content item-input">
                  <div class="item-inner">
                    <label class="item-title">Full Name</label>
                    <div class="item-input-wrap">
                      <input
                        type="text"
                        placeholder="Enter your full name"
                        id="full-name"
                        name="full_name"
                        class="fontSize-18"
                      />
                    </div>
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Email</label>
                  <div class="item-input">
                    <input
                      type="email"
                      placeholder="Enter your email"
                      id="email"
                      name="email"
                      class="fontSize-18"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content content-flex item-select item-input">
                <a
                  class="item-link smart-select smart-select-init w-100"
                  data-open-in="sheet"
                >
                  <select
                    name="country"
                    id="countries"
                    data-open-in="sheet"
                    value=""
                  >
                    <option value="">Select a country</option>
                  </select>
                  <div class="select-content">
                    <div for="countries" class="item-title w-20">Country</div>
                  </div>
                </a>
              </div>
              <div class="item-content content-flex item-select item-input">
                <a
                  class="item-link smart-select smart-select-init w-100"
                  data-open-in="sheet"
                >
                  <select name="city" id="cities" data-open-in="sheet" value="">
                    <option value="">Select a city</option>
                  </select>
                  <div class="select-content">
                    <label for="cities" class="item-title">City</label>
                  </div>
                </a>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Phone</label>
                  <div class="item-media">
                    <span id="phone-code">XXX</span>
                    <input
                      type="tel"
                      placeholder="Enter your phone number"
                      name="phone_number"
                      id="phoneNumber"
                      inputmode="numeric"
                      class="ml-5 fontSize-18"
                      maxlength="10"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <label class="item-title">Birthday</label>
                <div class="item-input">
                  <div class="item-media">
                    <input type="date" id="user_birthday" />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-inner btn-upload">
                <label for="profile_image" class="custom-file-upload"
                  >Upload Image</label
                >
                <input type="file" id="profile_image" accept="image/*" hidden />
                <div id="image_file"></div>
              </div>
            </li>
          </ul>
        </div>
        <!-- Professional Experience -->
        <h4>Professional Experience</h4>
        <div class="list">
          <ul>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Current Title</label>
                  <div class="item-input">
                    <input
                      type="text"
                      placeholder="Enter your job title"
                      id="current_title_job"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Current Company</label>
                  <div class="item-input">
                    <input
                      type="text"
                      placeholder="Enter your company name"
                      id="current_company"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Years of Experience</label>
                  <div class="item-input">
                    <input
                      type="text"
                      placeholder="Enter years of experience"
                      id="years_of_experience"
                    />
                  </div>
                </div>
              </div>
            </li>
          </ul>
        </div>
        <!-- Education -->
        <h4>Education</h4>
        <div class="list">
          <ul>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Name</label>
                  <div class="item-input">
                    <input
                      type="text"
                      placeholder="Enter your schoole name"
                      id="school_name"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Degree</label>
                  <div class="item-input">
                    <input
                      type="text"
                      placeholder="Enter your degree"
                      id="school_degree"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Start Year</label>
                  <div class="item-input">
                    <input
                      type="number"
                      placeholder="Enter your start year"
                      id="school_year_start"
                      min="1950"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-content item-input">
                <div class="item-inner">
                  <label class="item-title">Graduation Year</label>
                  <div class="item-input">
                    <input
                      type="number"
                      placeholder="Enter your graduation year"
                      id="school_year_end"
                      min="1950"
                    />
                  </div>
                </div>
              </div>
            </li>
            <li>
              <div class="item-inner btn-upload">
                <label for="cv_upload" class="custom-file-upload"
                  >Upload CV</label
                >
                <input
                  type="file"
                  id="cv_upload"
                  accept=".pdf,.doc,.docx"
                  hidden
                />
                <span
                  id="cv_filename"
                  style="font-size: 12px; display: block; margin-top: 5px"
                ></span>
              </div>
            </li>
          </ul>
        </div>
        <button type="submit" class="button button-fill-1">SUBMIT</button>
      </form>
      <button class="button button-fill-2 logout">Logout</button>
    </div>
  </div>
</template>

<style>
  .form-block > h4 {
    padding-left: 18px;
  }

  .file-input {
    margin-top: 10px;
  }

  .list {
    margin-bottom: 20px;
  }

  .list .item-content {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: calc(var(--f7-list-item-min-height));
    width: 90%;
    margin: 0px auto;
    border-radius: 20px;
    margin-top: 10px;
  }

  .btn-upload {
    flex-direction: column !important;
    justify-content: center !important;
  }

  .btn-upload .custom-file-upload {
    background-color: #007aff;
    border: none;
    border-radius: 5px;
    padding: 10px;
    color: white;
  }

  .list .item-link {
    display: block;
    padding-top: 9px;
    text-align: left;
  }

  .item-content.item-input {
    background-color: transparent !important;
  }

  .item-title {
    position: absolute;
    background: white;
    padding: 0 2px;
  }

  .item-content .form_select-control {
    width: 100%;
    height: auto;
    background-color: transparent !important;
    padding: 5px 0;
    font-size: 16px;
    font-weight: bold;
    color: #333;
    outline: none;
    cursor: pointer;
  }

  .item-content select {
    top: 0 !important;
    text-align: left;
  }

  /* Styling the dropdown options */
  .item-content .form_select-control option {
    background-color: #fff;
    color: #333;
    font-size: 16px;
    padding: 5px;
  }

  .item-radio .item-inner {
    padding-top: 0;
    padding-bottom: 5px;
    align-items: flex-end;
  }

  .select-content .item-after {
    font-size: 18px;
    text-align: left;
  }

  .button-fill-1 {
    width: 100%;
    background-color: #007aff;
    border: none;
    border-radius: 5px;
    padding: 10px;
    color: white;
    font-size: 16px;
  }

  .button-fill-1:hover {
    background-color: #005bb5;
  }

  .button-fill-2 {
    width: 100%;
    background-color: #ec3838;
    border: none;
    border-radius: 5px;
    padding: 10px;
    color: white;
    font-size: 16px;
  }

  .button-fill-2:hover {
    background-color: #f12626;
  }

  .smart-select .item-after {
    max-width: 100%;
  }

  .sheet-modal {
    height: 500px;
  }

  select#font-family {
    position: relative;
    top: 0px;
    background: none !important;
    font-weight: bold;
    float: right;
    right: -41px;
  }

  /* Input text field inside your styled list */
  .item-content.item-input input[type="text"] {
    width: 100%;
    padding: 10px 35px 10px 10px;
    font-size: 18px;
    font-weight: 500;
    border: none;
    background: transparent;
    color: #333;
    outline: none;
  }

  input[type="number"] {
    font-size: 18px;
    font-weight: 500;
  }

  /* Label styling (already styled but enhanced) */
  .item-title {
    position: absolute;
    top: -10px;
    left: 15px;
    background: white;
    padding: 0 4px;
    font-size: 14px;
    color: #007aff;
    font-weight: 600;
  }

  .message_required::first-letter {
    text-transform: uppercase;
  }
</style>

<script>
  export default (props, { $, $f7, $on, $f7router }) => {
    $on("pageInit", async () => {
      const user = getUser();
      const token = getToken();
      const candidat = localStorage.getItem("candidatProfile");

      if (!token || !user) return redirectToLogin();

      let candidateProfile = null;

      try {
        $f7.dialog.preloader("Loading person data...");
        candidateProfile = await fetchCandidateProfile(user.id, token);
        handleProfileStorage(candidateProfile);
        $f7.dialog.close();
        await fetchAndPopulateCountry();

        if (candidateProfile?.is_finished_profile) {
          populateCandidateFields(candidateProfile);
        }

        setupInitialUI(candidateProfile);
        bindFileInputs();

        // Ensure country select is ready before form submission
        await fetchAndPopulateCountry();

        $("#verifyProfileForm").on("submit", (e) => {
          e.preventDefault();
          handleSubmit(user.id, token);
        });

        $(".logout").on("click", logout);
      } catch (err) {
        console.error("Fetch error:", err);
        $f7.dialog.alert("Something went wrong while fetching data.", "Error");
      }
    });

    // -------------------------------
    // Utility + Composition Functions
    // -------------------------------
    const getUser = () => JSON.parse(localStorage.getItem("user"));
    const getToken = () => localStorage.getItem("jwt_token");

    const redirectToLogin = () => {
      $f7.dialog.alert(
        "You are not logged in. Please login to continue.",
        "Auth Error"
      );
      $f7router.navigate("/login");
    };

    const fetchCandidateProfile = async (userId, token) => {
      const res = await fetch(`http://127.0.0.1:8000/api/candidat/${userId}`, {
        headers: authHeaders(token),
      });
      const data = await res.json();
      return data?.candidateProfile || null;
    };

    const handleProfileStorage = (profile) => {
      if (profile?.is_finished_profile) {
        localStorage.setItem("candidatProfile", JSON.stringify(profile));
      } else {
        localStorage.setItem("candidatProfile", 0);
      }
    };

    const authHeaders = (token) => ({
      "Content-Type": "application/json",
      Accept: "application/json",
      Authorization: `Bearer ${token}`,
    });

    const setupInitialUI = (profile) => {
      const backLink = document.getElementById("backLink");
      const title = document.getElementById("profileTitle");

      backLink.style.display = profile === 0 ? "none" : "block";
      title.textContent = profile ? "Your Profile" : "Finish Profile";

      // Populate basic user fields
      const user = getUser();
      if (user) {
        $("#full-name").val(`${user.first_name} ${user.last_name}`);
        $("#email").val(user.email || profile.user.email);
      }

      $("#phoneNumber").on("input", function () {
        this.value = this.value.replace(/[^0-9]/g, "");
      });
    };

    const populateCandidateFields = (profile) => {
      $("#full-name").val(
        `${profile.user.first_name || ""} ${profile.user.last_name || ""}`
      );
      $("#email").val(profile.user.email || "");
      $("#user_birthday").val(profile.birthday || "");

      const phoneCode = profile.country?.phone_code || "";
      const cleanPhone = (profile.phone || "").replace(
        new RegExp(`^\\+?${phoneCode}`),
        ""
      );
      $("#phoneNumber").val(cleanPhone);
      $("#phone-code").text(`+${phoneCode}`);

      const isoCode = profile.country?.iso_code || "EN";
      localStorage.setItem("languageCode", isoCode);
      console.log("Language code set:", isoCode);
      // CV file
      if (profile.cv) {
        const fileName = profile.cv.split("/").pop();
        const fileUrl = `http://127.0.0.1:8000/api/candidat/${profile.cv}`;
        const fullName = `${profile.user.first_name} ${profile.user.last_name}`;

        const span = document.getElementById("cv_filename");
        if (span) {
          const link = document.createElement("a");
          link.href = fileUrl;
          link.target = "_blank";
          link.download = fileName;
          link.style.color = "#007aff";
          link.id = "cv_filename";
          link.textContent = `${fullName} - CV`;

          span.parentNode.replaceChild(link, span);
        }
      }

      // Image file
      if (profile.profile_image) {
        const defaultImage = "../assets/user-default.png";
        const imageUrl = profile.profile_image
          ? `http://127.0.0.1:8000/storage/${profile.profile_image}`
          : defaultImage;
        console.log(imageUrl)
        const imageSpan = document.getElementById("image_file");

        // Clear previous image if any
        imageSpan.innerHTML = "";

        // Create and inject image
        const img = document.createElement("img");
        img.src = imageUrl;
        img.alt = "Profile";
        img.id = "profile_image_preview";
        img.style.width = "120px";
        img.style.height = "120px";
        img.style.objectFit = "cover";
        img.style.borderRadius = "50%";
        img.style.margin = "10px 0";
        img.style.border = "1px solid grey";

        imageSpan.appendChild(img);
      }

      const fields = [
        "current_company",
        "current_title_job",
        "years_of_experience",
        "school_name",
        "school_degree",
        "school_year_start",
        "school_year_end",
      ];

      fields.forEach((id) => $(`#${id}`).val(profile[id] || ""));

      if (profile.country_id)
        setTimeout(() => setSelect("countries", profile.country_id), 100);
      if (profile.city_id)
        setTimeout(() => setSelect("cities", profile.city_id), 150);
    };

    const setSelect = (id, value) => {
      $(`#${id}`).val(value).trigger("change");
      const selectEl = document.getElementById(id);
      const selectedText = selectEl.options[selectEl.selectedIndex]?.text || "";
      $(`#${id}`)
        .closest(".smart-select")
        .find(".item-after")
        .text(selectedText);
    };

    const bindFileInputs = () => {
      const bind = (inputId, labelId, onChangeCallback) => {
        const input = document.getElementById(inputId);
        const label = document.getElementById(labelId);
        if (input && label) {
          input.addEventListener("change", () => {
            const file = input.files[0];

            if (file) label.textContent = file.name;
            if (onChangeCallback) onChangeCallback(file);
          });
        }
      };

      bind("profile_image", null, (file) => {
        const imageSpan = document.getElementById("image_file");
        if (!imageSpan) return;

        imageSpan.innerHTML = "";

        const img = document.createElement("img");
        const objectUrl = URL.createObjectURL(file);
        img.src = `${objectUrl}#${Date.now()}`;
        img.alt = "Profile Preview";
        img.id = "profile_image_preview";
        img.style.width = "120px";
        img.style.height = "120px";
        img.style.objectFit = "cover";
        img.style.borderRadius = "50%";
        img.style.margin = "10px 0";
        img.style.border = "1px solid grey";

        img.onload = () => URL.revokeObjectURL(objectUrl);

        imageSpan.appendChild(img);
      });

      bind("cv_upload", "cv_filename", (file) => {
        const label = document.getElementById("cv_filename");
        const profile = JSON.parse(localStorage.getItem("candidatProfile"));
        const firstName = profile?.user?.first_name || "First";
        const lastName = profile?.user?.last_name || "Last";

        if (file && label) {
          const fullName = `${firstName} ${lastName}`;
          label.textContent = `${fullName} - CV`;
        }
      });
    };

    const fetchAndPopulateCountry = async () => {
      const token = getToken();
      const stored = localStorage.getItem("countriesData");

      const selectedCountryId = JSON.parse(
        localStorage.getItem("candidatProfile")
      )?.country?.id;

      if (stored) {
        populateCountries(JSON.parse(stored), selectedCountryId);
        return;
      }

      try {
        const res = await fetch("http://127.0.0.1:8000/api/countries", {
          headers: authHeaders(token),
        });
        const data = await res.json();
        const countries = Array.isArray(data) ? data : data?.countries || [];
        localStorage.setItem("countriesData", JSON.stringify(countries));
        populateCountries(countries, selectedCountryId);
      } catch (err) {
        console.error("Country fetch error:", err);
      }
    };

    const populateCountries = (countries, selectedId = "") => {
      const $select = $("#countries")
        .empty()
        .append('<option value="">Select a country</option>');
      countries
        .sort((a, b) => (a.id == selectedId ? -1 : 1))
        .forEach((c) => {
          $select.append(
            `<option value="${c.id}" ${c.id == selectedId ? "selected" : ""}>${
              c.name
            }</option>`
          );
        });

      refreshSmartSelect("#countries");

      $("#countries")
        .off("change")
        .on("change", function () {
          const id = $(this).val();
          if (id) {
            fetchPhoneCode(id);
            fetchCities(id);
          } else {
            $("#phone-code").text("XXX");
            $("#cities").html('<option value="">Select a city</option>');
          }
        });

      if (selectedId) {
        fetchPhoneCode(selectedId);
        fetchCities(selectedId);
      }
    };

    const fetchCities = async (countryId) => {
      const token = getToken();
      const key = `citiesData-${countryId}`;
      const stored = localStorage.getItem(key);
      const selectedCityId = JSON.parse(localStorage.getItem("candidatProfile"))
        ?.city?.id;

      if (stored) {
        populateCities(JSON.parse(stored), selectedCityId);
        return;
      }

      try {
        const res = await fetch(
          `http://127.0.0.1:8000/api/cities/${countryId}`,
          {
            headers: authHeaders(token),
          }
        );
        const data = await res.json();
        const cities = Array.isArray(data) ? data : data?.cities || [];
        localStorage.setItem(key, JSON.stringify(cities));
        populateCities(cities, selectedCityId);
      } catch (err) {
        console.error("City fetch error:", err);
        $("#cities").html('<option value="">Select a city</option>');
      }
    };

    const populateCities = (cities, selectedId = "") => {
      const $select = $("#cities")
        .empty()
        .append('<option value="">Select a city</option>');
      cities
        .sort((a, b) => (a.id == selectedId ? -1 : 1))
        .forEach((c) => {
          $select.append(
            `<option value="${c.id}" ${c.id == selectedId ? "selected" : ""}>${
              c.name
            }</option>`
          );
        });

      refreshSmartSelect("#cities");
    };

    const fetchPhoneCode = async (countryId) => {
      try {
        const res = await fetch(
          `http://127.0.0.1:8000/api/country/${countryId}/phone-code`
        );
        const data = await res.json();
        $("#phone-code").text(data.phone ? `+${data.phone}` : "XXX");
      } catch (err) {
        console.error("Phone code error:", err);
      }
    };

    const handleSubmit = (userId, token) => {
      const errors = validateForm();
      if (errors.length > 0) {
        const msgHtml = errors
          .map((e) => `<div>• <span class="message_required">${e}</span></div>`)
          .join("");
        $f7.dialog.alert(msgHtml, "Validation Errors");
        return;
      }

      const formData = buildFormData(userId);
      const preloader = $f7.dialog.preloader("Updating...");

      fetch(`http://127.0.0.1:8000/api/candidat/profile/update/${userId}`, {
        method: "POST",
        headers: { Authorization: `Bearer ${token}` },
        body: formData,
      })
        .then((response) => {
          if (!response.ok) {
            throw new Error("Failed to save user profile!");
          }
          return response.json();
        })
        .then((data) => {
          localStorage.setItem(
            "candidatProfile",
            JSON.stringify(data?.candidateProfile?.original?.data)
          );
          $f7.dialog.close();
          $f7.dialog.alert(data.message, "Update", () => {
            $f7router.navigate("/main/");
          });
          const url= data?.candidateProfile?.original?.data.profile_image;
          if (url) {
            const imageUrl = `http://127.0.0.1:8000/storage/${url}`;
            const imageSpan = document.getElementById("image_file");
            imageSpan.innerHTML = "";

            const img = document.createElement("img");
            img.src = imageUrl;
            img.alt = "Profile";
            img.id = "profile_image_preview";
            img.style.width = "120px";
            img.style.height = "120px";
            img.style.objectFit = "cover";
            img.style.borderRadius = "50%";
            img.style.margin = "10px 0";
            img.style.border = "1px solid grey";

            imageSpan.appendChild(img);
          }
        })
        .catch((err) => {
          console.error("Submit error:", err);
          $f7.dialog.close();
          $f7.dialog.alert(
            "Something went wrong while submitting the profile.",
            "Error"
          );
        });
    };

    const validateForm = () => {
      const errors = [];

      const check = (id, validator, msg) => {
        const el = document.getElementById(id);
        const val = el?.type === "file" ? el.files[0] : el?.value.trim();
        if (!validator(val))
          errors.push(msg || `${id.replace(/_/g, " ")} is required.`);
      };

      check("full-name", (v) => !!v);
      check("email", (v) => !!v);
      check(
        "phoneNumber",
        (v) => /^\d+$/.test(v),
        "Phone number must contain only digits."
      );
      check("cities", (v) => !!v);
      check("current_title_job", (v) => !!v);
      check("current_company", (v) => !!v);
      check(
        "years_of_experience",
        (v) => /^\d{1,2}$/.test(v) && +v >= 1 && +v <= 99,
        "Experience must be 1–99."
      );
      check("school_degree", (v) => !!v);
      check("school_name", (v) => !!v);
      check(
        "school_year_start",
        (v) => /^\d{4}$/.test(v),
        "School year start must be a 4-digit year."
      );
      check(
        "school_year_end",
        (v) => /^\d{4}$/.test(v),
        "School year end must be a 4-digit year."
      );

      const cvInput = document.getElementById("cv_upload");
      const cvFile = cvInput?.files[0];
      const cvLink = document.querySelector("#cv_filename[href]"); // check if it's a link

      if ((!cvFile && !cvLink) || (cvFile && cvFile.size > 5 * 1024 * 1024)) {
        errors.push("CV is required and must be under 5MB.");
      }

      return errors;
    };

    const buildFormData = (userId) => {
      const formData = new FormData();
      const phoneCode = $("#phone-code").text().trim();
      const phone = phoneCode + $("#phoneNumber").val().trim();

      const fullName = $("#full-name").val().trim().split(" ");
      const firstName = fullName[0],
        lastName = fullName.slice(1).join(" ");

      formData.append("user_id", userId);
      formData.append("first_name", firstName);
      formData.append("last_name", lastName);
      formData.append("country_id", $("#countries").val());
      formData.append("city_id", $("#cities").val());
      formData.append("birthday", $("#user_birthday").val());
      formData.append("phone", phone);
      formData.append("current_company", $("#current_company").val());
      formData.append("current_title_job", $("#current_title_job").val());
      formData.append("years_of_experience", $("#years_of_experience").val());
      formData.append("school_name", $("#school_name").val());
      formData.append("school_degree", $("#school_degree").val());
      formData.append("school_year_start", $("#school_year_start").val());
      formData.append("school_year_end", $("#school_year_end").val());

      const profileImage = document.getElementById("profile_image")?.files[0];
      const cvFile = document.getElementById("cv_upload")?.files[0];
      if (profileImage) formData.append("profile_image", profileImage);
      if (cvFile) formData.append("cv", cvFile);

      return formData;
    };

    const logout = () => {
      localStorage.clear();
      $f7router.navigate("/login/");
    };

    const refreshSmartSelect = (selector) => {
      const ssEl = document.querySelector(selector);
      if (ssEl?.f7SmartSelect) ssEl.f7SmartSelect.destroy();
      const app = Framework7?.instance || new Framework7();
      app.smartSelect.create({ el: selector });
    };

    return $render;
  };
</script>
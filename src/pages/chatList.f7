<template>
  <div class="page" data-name="chatList">
    <div class="navbar navbar-fancy">
      <div class="navbar-inner-custom">
        <div class="left">
          <a href="/main/" class="link">
            <i class="icon f7-icons">arrow_left</i>
          </a>
        </div>
        <div class="center">
          <img
            src="../assets/circle.svg"
            alt="imjob logo"
            class="navbar-logo-center"
          />
        </div>
        <div class="right">
          <a href="/profile/">
            <img
              src="../assets/setting.png"
              alt="profile"
              class="navbar-profile-icon"
            />
          </a>
        </div>
      </div>
    </div>

    <!-- Panel -->
    <div class="panel panel-left panel-reveal">
      <div class="sidebar__close panel-close">
        <i class="icon f7-icons">close</i>
      </div>
      <div class="sidebar__links">
        <div class="sidebar__item">
          <a href="/applyJobs/" class="panel-close" data-transition="f7-push"
            >Apply jobs</a
          >
        </div>
        <div class="sidebar__item">
          <a href="/settings/" class="panel-close" data-transition="f7-push"
            >Settings</a
          >
        </div>
      </div>
    </div>

    <div class="page-content pt-50">
      <div class="block">
        <div id="recuiter-chat"></div>
      </div>
    </div>
    <!-- Begin of footer -->
    <footer class="footer">
      <div class="footer-nav">
        <div class="trty">
          <a href="/main/">
            <img src="../assets/employers.svg" class="ft-img" alt="icon" />
            <p>Home</p>
          </a>
        </div>
        <div class="trty center-button">
          <a href="/ai/">
            <div class="circle-btn">
              <img src="../assets/circle.svg" alt="AI" />
            </div>
            <!-- <p>AI</p> -->
          </a>
        </div>
        <div class="trty">
          <a href="/chatList/">
            <img src="../assets/feedback.svg" class="ft-img" alt="icon" />
            <p>Chats</p>
            <span id="unread-badge" class="badge unread-badge">0</span>
          </a>
        </div>
      </div>
    </footer>
    <!-- End of footer -->
  </div>
</template>

<script>
  export default (props, { $f7, $el, $on, $ }) => {
    $on("pageInit", () => {
      const jwtToken = localStorage.getItem("jwt_token");

      window.updateGlobalUnreadBadge?.();

      if (!jwtToken) {
        localStorage.clear();

        const dialog = $f7.dialog.create({
          title: "Auth Error",
          text: "You are not logged in. Please login to continue.",
          buttons: [
            {
              text: "OK",
              bold: true,
              onClick: () => {
                $f7router.navigate("/login");
              },
            },
          ],
          closeByBackdropClick: false,
        });

        dialog.open();
        return;
      }

      $f7.dialog.preloader("Loading chats...");

      const fetchRecruiter = () => {
        fetch(`http://127.0.0.1:8000/api/active/contacts/chats`, {
          method: "GET",
          headers: {
            Authorization: `Bearer ${jwtToken}`,
          },
        })
          .then((response) => {
            if (!response.ok) throw new Error("Network response was not ok");
            return response.json();
          })
          .then((data) => {
            displayRecruiter(data.data);
            window.updateGlobalUnreadBadge?.();
            $f7.dialog.close();
          })
          .catch((error) => {
            console.error("Fetch error:", error);
            $f7.dialog.alert("Something wrong to fetch", "Error");
          });
      };

      const displayRecruiter = (recruiters) => {
        const jobPosts = document.querySelector("#recuiter-chat");
        jobPosts.innerHTML = "";
        localStorage.setItem("chat_list", JSON.stringify(recruiters));
        console.log("Caht list: ", recruiters);
        if (recruiters.length > 0) {
          const jobHTML = `
            <div class="list simple-list media-list">
              <ul>
                ${recruiters
                  .map(
                    (recruiter) => `
                      <li>
                        <a href="/chatroom/${recruiter.id}" 
                          class="item-link item-content recruiter-chat-link" 
                          data-recruiter-id="${recruiter.id}" 
                          data-unread-count="${recruiter.unread_count}">
                          <div class="item-media">
                            <img src="../assets/feedback.svg" style="width: 28px; border-radius: 50%" />
                          </div>
                          <div class="item-inner">
                            <div class="item-title">${recruiter.first_name} ${
                      recruiter.last_name
                    }</div>
                            <div class="item-after">
                              ${
                                recruiter.unread_count > 0
                                  ? `<span class="badge color-red">${recruiter.unread_count}</span>`
                                  : ""
                              }
                            </div>
                          </div>
                        </a>
                      </li>
                      <hr>
                    `
                  )
                  .join("")}
              </ul>
            </div>
          `;

          jobPosts.insertAdjacentHTML("beforeend", jobHTML);
        } else {
          const jobHTML = `
            <div class="recruiter-chat__card">
              <h4>You are not part of the recruitment process yet.</h4><br>
              <p>A recruiter will contact you once your application has been accepted.</p>
            </div>
          `;
          jobPosts.innerHTML = jobHTML;
        }
      };

      fetchRecruiter();
    });

    $on("pageBeforeOut", () => {
      if (document.activeElement) {
        document.activeElement.blur();
      }
    });

    window.moveSenderToTopOfList = function (senderId) {
      let chatList = JSON.parse(localStorage.getItem("chat_list") || "[]");
      const index = chatList.findIndex((item) => item.id == senderId);
      if (index !== -1) {
        const [sender] = chatList.splice(index, 1);
        chatList.unshift(sender);
        localStorage.setItem("chat_list", JSON.stringify(chatList));

        window.refreshChatListUI(senderId);

        setTimeout(() => {
          const link = document.querySelector(
            `.recruiter-chat-link[data-recruiter-id="${senderId}"]`
          );
          if (link && link.parentElement) {
            link.parentElement.classList.remove("recruiter-highlight");
          }
        }, 2000);
      }
    };

    window.refreshChatListUI = function (highlightedId = null) {
      const recruiters = JSON.parse(localStorage.getItem("chat_list") || "[]");
      if (!recruiters.length) return;

      const jobPosts = document.querySelector("#recuiter-chat");
      if (!jobPosts) return;

      const listHTML = recruiters
        .map((recruiter) => {
          const highlightClass =
            recruiter.id == highlightedId ? "recruiter-highlight" : "";

          return `
            <li class="${highlightClass}">
              <a href="/chatroom/${recruiter.id}" 
                class="item-link item-content recruiter-chat-link" 
                data-recruiter-id="${recruiter.id}" 
                data-unread-count="${recruiter.unread_count}">
                <div class="item-media">
                  <img src="../assets/feedback.svg" style="width: 28px; border-radius: 50%" />
                </div>
                <div class="item-inner">
                  <div class="item-title">${recruiter.first_name} ${
            recruiter.last_name
          }</div>
                  <div class="item-after">
                    ${
                      recruiter.unread_count > 0
                        ? `<span class="badge color-red">${recruiter.unread_count}</span>`
                        : ""
                    }
                  </div>
                </div>
              </a>
            </li>
            <hr>`;
        })
        .join("");

      jobPosts.innerHTML = `
        <div class="list simple-list media-list">
          <ul>${listHTML}</ul>
        </div>
      `;
      window.updateGlobalUnreadBadge?.();
    };

    window.updateGlobalUnreadBadge = function () {
      const badgeEl = document.getElementById("unread-badge");
      const unreadCount = parseInt(localStorage.getItem("unread_count") || "0");

      if (badgeEl) {
        if (unreadCount > 0) {
          badgeEl.textContent = unreadCount;
          badgeEl.style.display = "inline-block";
        } else {
          badgeEl.style.display = "none";
        }
      }
    };

    window.markAsReadForRecruiter = async function (recruiterId) {
      const jwtToken = localStorage.getItem("jwt_token");
      if (!jwtToken) return;

      try {
        // Poziv API-ja za mark as read
        const response = await fetch(
          `http://127.0.0.1:8000/api/messages/mark-as-read/${recruiterId}`,
          {
            method: "POST",
            headers: {
              Authorization: `Bearer ${jwtToken}`,
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ user_id: recruiterId }),
          }
        );

        if (!response.ok) throw new Error("Failed to mark as read");

        // Ažuriranje localStorage podataka
        let chatList = JSON.parse(localStorage.getItem("chat_list") || "[]");
        let unreadCount = parseInt(localStorage.getItem("unread_count") || "0");
        let unreadMap = JSON.parse(
          localStorage.getItem("unread_sender_map") || "{}"
        );

        // Nađi u listi i resetuj unread_count za datog rekrutera
        const index = chatList.findIndex((r) => r.id == recruiterId);
        if (index !== -1) {
          chatList[index].unread_count = 0;
        }

        // Smanji ukupni unread count i izbriši iz mape
        if (unreadMap[recruiterId]) {
          unreadCount -= unreadMap[recruiterId];
          delete unreadMap[recruiterId];
        }

        // Sačuvaj nazad u localStorage
        localStorage.setItem("chat_list", JSON.stringify(chatList));
        localStorage.setItem("unread_count", unreadCount);
        localStorage.setItem("unread_sender_map", JSON.stringify(unreadMap));

        // Osveži UI
        window.refreshChatListUI();
        window.updateGlobalUnreadBadge();
      } catch (error) {
        console.error("Mark as read error:", error);
      }
    };

    return $render;
  };
</script>

<style>
  .recruiter-chat__card {
    padding: 16px;
    margin-bottom: 20px;
    border-radius: 12px;
    border: 1px solid #e0e0e0;
    background-color: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
  }
  .pt-50 {
    padding-top: 50px;
  }
  .list .item-content {
    width: 100%;
  }
  .item-inner {
    position: relative !important;
  }

  .item-after {
    position: absolute !important;
    top: 5px;
    right: 3px;
  }
  .message-sent .message-bubble {
    border-radius: #7f7fea !important;
  }

  .recruiter-highlight {
    animation: pulseHighlight 1.5s ease-out;
    background-color: #ddd4e9 !important; /* svetložuta pozadina */
    transition: background-color 1s ease;
    border-radius: 12px;
  }

  @keyframes pulseHighlight {
    0% {
      background-color: #ddd4e9;
      transform: scale(1);
    }
    50% {
      background-color: #bfbcfb;
      transform: scale(1.02);
    }
    100% {
      background-color: #ddd4e9;
      transform: scale(1);
    }
  }
</style>

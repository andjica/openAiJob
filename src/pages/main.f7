<template>
  <div class="page" data-name="main">
    <!-- Header -->
    <div class="navbar navbar-fancy">
      <div class="navbar-inner-custom">
        <div class="left">
          <a href="#" class="link icon-only panel-open" data-panel="left">
            <i class="icon f7-icons">menu</i>
          </a>
        </div>
        <div class="center">
          <img
            src="../assets/circle.svg"
            alt="imjob logo"
            class="navbar-logo-center"
          />
        </div>
        <div class="right">
          <a href="/profile/">
            <img
              src="../assets/setting.png"
              alt="profile"
              class="navbar-profile-icon"
            />
          </a>
        </div>
      </div>
    </div>

    <!-- Panel -->
    <div class="panel panel-left panel-reveal">
      <div class="sidebar__close panel-close">
        <i class="icon f7-icons">close</i>
      </div>
      <div class="sidebar__links">
        <div class="sidebar__item">
          <a href="/applyJobs/" class="panel-close" data-transition="f7-push"
            >Apply jobs</a
          >
        </div>
        <div class="sidebar__item">
          <a href="/settings/" class="panel-close" data-transition="f7-push"
            >Settings</a
          >
        </div>
      </div>
    </div>

    <!-- Content -->
    <div class="page-content pt-30">
      <div class="block mt-60">
        <h3 class="slider-title text-black">National Jobs</h3>
        <div class="swiper-container swiper-national">
          <div class="swiper-wrapper" id="national-wrapper"></div>
          <!-- <div class="swiper-pagination swiper-national-pagination"></div> -->
        </div>

        <h3 class="slider-title text-black">International Jobs</h3>
        <div class="swiper-container swiper-international">
          <div class="swiper-wrapper" id="international-wrapper"></div>
          <!-- <div class="swiper-pagination swiper-international-pagination"></div> -->
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-nav">
        <div class="trty">
          <a href="/main/">
            <img src="../assets/employers.svg" class="ft-img" alt="icon" />
            <p>Home</p>
          </a>
        </div>
        <div class="trty center-button">
          <a href="/ai/">
            <div class="circle-btn">
              <img src="../assets/circle.svg" alt="AI" />
            </div>
          </a>
        </div>
        <div class="trty">
          <a href="/chatList/">
            <img src="../assets/feedback.svg" class="ft-img" alt="icon" />
            <p>Chats</p>
            <span id="unread-badge" class="badge unread-badge">0</span>
          </a>
        </div>
      </div>
    </footer>
  </div>
</template>

<style>
  .title {
    text-align: center;
    padding-top: 20px;
  }

  .swiper-container {
    height: 400px;
    margin-top: 20px;
    padding: 0 20px;
  }

  .swiper-wrapper {
    height: 100%;
  }

  .swiper-slide {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100%;
    box-sizing: border-box;
  }

  .job-post {
    width: 100%;
    height: 90%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid #ddd;
    padding: 20px;
    background-color: #f9f9f9;
    overflow-y: auto;
    box-sizing: border-box;
  }

  .job-post h2 {
    font-size: 18px;
    font-weight: bold;
  }

  .job-post p {
    font-size: 14px;
    color: #555;
  }

  .job-post .button {
    margin-top: 10px;
    background-color: #007bff;
    color: white;
  }

  .swiper-pagination {
    bottom: 0px !important;
  }

  .swiper-button-next,
  .swiper-button-prev {
    color: #007bff;
  }

  .pos_abs {
    position: absolute;
    top: 36px;
    right: 9px;
  }

  .icon-ai {
    position: absolute;
    bottom: 0px;
  }
</style>

<script>
  export default (props, { $, $on, $f7, $f7router }) => {
    $on("page:init", () => {
  
      const jwtToken = localStorage.getItem("jwt_token");
      window.updateGlobalUnreadBadge?.();
      console.log("JONE", window.updateGlobalUnreadBadge?.());
      if (!jwtToken) {
        localStorage.clear();

        $f7.dialog.alert(
          "You are not logged in. Please login to continue.",
          "Auth Error"
        );
        $f7router.navigate("/login");
        return;
      }

      $f7.dialog.preloader("Loading jobs...");

      fetch(`http://127.0.0.1:8000/api/jobs/active/national`, {
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
          Authorization: `Bearer ${jwtToken}`,
        },
      })
        .then((res) => res.json())
        .then((data) => {
          const jobs = data.randomFiveJobs || data;
          renderSlidesNational(jobs);
          initSwiper();
          $f7.dialog.close();
        })
        .catch((err) => {
          console.error("Error:", err);
          $f7.dialog.alert(
            "Something went wrong while fetching jobs.",
            "Error"
          );
        });

      fetch(`http://127.0.0.1:8000/api/jobs/active/international`, {
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
          Authorization: `Bearer ${jwtToken}`,
        },
      })
        .then((res) => res.json())
        .then((data) => {
          const jobs = data.data || data;
          renderSlidesInternational(jobs);
          initSwiper();
          $f7.dialog.close();
        })
        .catch((err) => {
          console.error("Error:", err);
          $f7.dialog.alert(
            "Something went wrong while fetching jobs.",
            "Error"
          );
        });

      function renderSlidesNational(jobs) {
        const nationalWrapper = document.getElementById("national-wrapper");
        console.log("MAIN JOBS: ", jobs);
        nationalWrapper.innerHTML = "";
        jobs.forEach((job) => {
          const badge = '<span class="badge color-orange">national</span>';
          const displayImage = job.company.logo
            ? `<img src="http://127.0.0.1:8000/storage/${job.company.logo}" class="pos_abs" width="50" height="50" alt="${job.company.name}" />`
            : "";
          const slide = document.createElement("div");
          slide.className = "swiper-slide";
          slide.innerHTML = `
          <div class="job-post">
            <div class="job-post__details">
              ${badge}
              <h3>${job.title}<br><i><small>${job.category.name}, ${job.sub_category.name}</small></i></h3>
              <p>${job.country.name}, ${job.city.name}<br>
              Company: ${job.company.name}</p>
              ${displayImage}
            </div>
            <a href="/job/${job.id}" class="button">View Details</a>
          </div>
        `;

          nationalWrapper.appendChild(slide);
        });
      }

      function renderSlidesInternational(jobs) {
        const internationalWrapper = document.getElementById(
          "international-wrapper"
        );

        internationalWrapper.innerHTML = "";
        jobs.forEach((job) => {
          const badge = '<span class="badge color-blue">international</span>';
          const displayImage = job.company.logo
            ? `<img src="http://127.0.0.1:8000/storage/${job.company.logo}" class="pos_abs" width="50" height="50" alt="${job.company.name}" />`
            : "";
          const slide = document.createElement("div");
          slide.className = "swiper-slide";
          slide.innerHTML = `
          <div class="job-post">
            <div class="job-post__details">
              ${badge}
              <h3>${job.title}<br><i><small>${job.category.name}, ${job.sub_category.name}</small></i></h3>
              <p>${job.country.name}, ${job.city.name}<br>
              Company: ${job.company.name}</p>
              ${displayImage}
            </div>
            <a href="/job/${job.id}" class="button">View Details</a>
          </div>
        `;

          internationalWrapper.appendChild(slide);
        });
      }

      function initSwiper() {
        new Swiper(".swiper-national", {
          slidesPerView: 1.2,
          spaceBetween: 20,
          pagination: {
            el: ".swiper-national-pagination",
            clickable: true,
          },
        });

        new Swiper(".swiper-international", {
          slidesPerView: 1.2,
          spaceBetween: 20,
          pagination: {
            el: ".swiper-international-pagination",
            clickable: true,
          },
        });
      }
    });

    return $render;
  };
</script>

<template>
  <div class="page" data-name="chatroom">
    <!-- Begin of header -->
    <div class="navbar navbar-fancy">
      <div class="navbar-inner-custom">
        <div class="left">
          <a href="/chatList/" class="link">
            <i class="icon f7-icons">arrow_left</i>
          </a>
        </div>

        <div class="center">
          <img
            src="../assets/assets/circle.svg"
            alt="imjob logo"
            class="navbar-logo-center"
          />
        </div>

        <div class="right">
          <a href="/profile/">
            <img
              src="../assets/assets/setting.png"
              alt="profile"
              class="navbar-profile-icon"
            />
          </a>
        </div>
      </div>
    </div>
    <!-- End of header -->
    <div class="block chatroom-container">
      <div class="page-content messages-content messages-scroll">
        <div class="messages"></div>
      </div>

      <div
        class="toolbar messagebar"
        @messagebar:attachmentdelete="${deleteAttachment}"
      >
        <div class="toolbar-inner">
          <div class="messagebar-area">
            <textarea class="resizable" placeholder="Message"></textarea>
          </div>
          <a
            class="link icon-only demo-send-message-link"
            @click="${sendMessage}"
          >
            <i class="icon f7-icons if-not-md">arrow_up_circle_fill</i>
            <i class="icon material-icons md-only">send</i>
          </a>
        </div>
      </div>
    </div>
  </div>
</template>

<style>
  .h-100 {
    height: 100%;
  }

  .chatroom-container {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 56px - 56px); /* -navbar -footer (adjust if needed) */
  }

  .messages-content {
    flex: 1;
    overflow-y: auto;
    min-height: 0;
    padding-top: 20px !important;
  }

  .messagebar {
    flex-shrink: 0;
    border-top: 1px solid #ddd;
    background: #fff;
  }

  .messagebar .messagebar-area textarea {
    min-height: 40px;
    max-height: 120px;
    resize: none;
    overflow-y: auto;
  }

  .message-sent {
    text-align: right;
  }
  .message-received {
    text-align: left;
  }
  .message-bubble {
    display: inline-block;
    padding: 8px 12px;
    border-radius: 16px;
    background: #eee;
    /* max-width: 75%; */
  }
  .message-sent .message-bubble {
    background: #005bc1;
  }

  .message.no-radius .message-bubble {
    border-radius: 20px !important;
  }
</style>

<script>
  export default (props, { $, $f7, $on, $f7router }) => {
    let receiver_id;

    const lastMessageIds = new Set();
    let jwtToken = localStorage.getItem("jwt_token");
    const user = JSON.parse(localStorage.getItem("user"));
    const myId = user.id;

    const deleteAttachment = (e, index) => {
      const image = messagebar.attachments.splice(index, 1)[0];
      messagebar.renderAttachments();
      checkAttachments();
    };

    const checkAttachments = () => {
      if (messagebar.attachments.length > 0) {
        messagebar.attachmentsShow();
        messagebar.setPlaceholder("Add comment or Send");
      } else {
        messagebar.attachmentsHide();
        messagebar.setPlaceholder("Message");
      }
    };

    const escapeHtml = (unsafe) => {
      if (!unsafe) return "";
      return unsafe
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    };

    const addMessageUI = (msg, currentUserId) => {
      console.log("addMessageUI 12345678910: ", msg);
    // if (lastMessageIds.has(msg?.id || msg?.message?.id)) return;
      // lastMessageIds.add(msg?.id || msg?.message?.id);
      
      const messagesContainer = document.querySelector(".messages");
      const senderId = msg?.user_id ?? msg?.message?.user_id;
      
      const isSent = senderId === currentUserId;

      const messageEl = document.createElement("div");
      messageEl.className = `message ${
        isSent ? "message-sent" : "message-received"
      } no-radius`;
      messageEl.innerHTML = `
        <div class="message-content">
          <div class="message-bubble">
            <div class="message-text">${escapeHtml(msg?.text || msg?.message?.text)}</div>
          </div>
        </div>
      `;
      messagesContainer.appendChild(messageEl);
      setTimeout(() => {
        const lastMessage = messagesContainer.querySelector(
          ".message:last-child"
        );
        lastMessage?.scrollIntoView({ behavior: "smooth", block: "end" });
      }, 100);
    };

    const renderMessages = (messages) => {
      const messagesContainer = document.querySelector(".messages");
      messagesContainer.innerHTML = "";
      lastMessageIds.clear();

      const currentUserId = user.id;
      messages.forEach((msg) => {
        if (!msg.text || lastMessageIds.has(msg.id)) return;
        lastMessageIds.add(msg.id);
        const isSent = msg.user_id === currentUserId;
        const messageEl = document.createElement("div");
        messageEl.className = `message ${
          isSent ? "message-sent" : "message-received"
        } no-radius`;
        messageEl.innerHTML = `
      <div class="message-content">
        <div class="message-bubble">
          <div class="message-text">${escapeHtml(msg.text)}</div>
        </div>
      </div>
    `;
        messagesContainer.appendChild(messageEl);
      });
      // Scroll to last message after rendering all
      setTimeout(() => {
        const lastMessage = messagesContainer.querySelector(
          ".message:last-child"
        );
        lastMessage?.scrollIntoView({ behavior: "smooth", block: "end" });
      }, 100);
    };

    const fetchMessage = async (receiverId) => {
      await fetch(`https://fluffycave.nl/api/messages/${receiverId}`, {
        method: "GET",
        headers: {
          Authorization: `Bearer ${jwtToken}`,
        },
      })
        .then((res) => res.json())
        .then((data) => {
          console.log("fetchMessage chatroom: ", data);
          renderMessages(data);
        })
        .catch((err) => {
          console.error("Failed to fetch messages:", err);
        });
    };

    const sendMessage = () => {
      const textarea = document.querySelector(".messagebar textarea");
      const message = textarea.value.trim();
      if (!message) return;
      fetch("https://fluffycave.nl/api/store/messages", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/json",
          Authorization: `Bearer ${jwtToken}`,
        },
        body: JSON.stringify({
          text: message,
          receiver_id: Number(receiver_id),
        }),
      })
        .then((response) => {
          console.log("RESPONSE: ", response);
          if (!response.ok) {
            return response.json().then((err) => {
              throw err;
            });
          }
          return response.json();
        })
        .then((data) => {
          console.log("Message sent:", data);
          textarea.value = "";
          // Optionally just addMessageUI here
          textarea.focus();
          addMessageUI(data, myId);
        })
        .catch((error) => {
          console.error("Failed to send message:", error);
        });
    };

    $on("pageInit", (e, page) => {
      receiver_id = page.route.params.id;
      localStorage.setItem("active_chat_id", receiver_id);
      console.log("Skim se dopisujem: ", receiver_id);
      let mapStr = localStorage.getItem("unread_sender_map");
      let map = JSON.parse(mapStr || "{}");
      let firstKey = Object.keys(map)[0];

      console.log(firstKey); // "71" (kao string)
      console.log(Number(firstKey));

      window.clearUnreadForUser?.(parseInt(receiver_id));

      window.updateGlobalUnreadBadge?.();
      // const titleEl = document.getElementById("activeChatTitle");
      // if (titleEl) {
      //   titleEl.textContent = `Chat Room - #${receiver_id}`;
      // }

      const markAsReadAndNavigate = async function () {
        try {
          const response = await fetch(
            `https://fluffycave.nl/api/messages/mark-as-read/${receiver_id}`,
            {
              method: "POST",
              headers: {
                Authorization: `Bearer ${localStorage.getItem("jwt_token")}`,
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                user_id: receiver_id,
              }),
            }
          );

          if (!response.ok) {
            throw new Error("Failed to mark as read");
          }

          // Navigate after marking as read
          const f7 =
            window.Framework7.instance ||
            document.querySelector(".view").f7View;
        } catch (err) {
          console.error("Error marking as read:", err);
        }
      };

      fetchMessage(receiver_id);
      markAsReadAndNavigate();

      if (window.Echo && typeof window.Echo.private === "function") {
        window.Echo.private(`chat.${myId}`).listen(
          ".MessageSent",
          async (msg) => {
            const newMsg = msg.message;
            console.log("Nova poruka stigla:", newMsg);

            const activeChatId = parseInt(
              localStorage.getItem("active_chat_id") || "0"
            );

            if (
              newMsg.user_id !== myId &&
              (newMsg.user_id === activeChatId ||
                newMsg.receiver_id === activeChatId) &&
              !lastMessageIds.has(newMsg.id)
            ) {
              lastMessageIds.add(newMsg.id);
              if (navigator.vibrate) navigator.vibrate(100);
              addMessageUI(newMsg, myId);
            }
          }
        );
      }
    });

    $on("pageBeforeOut", async () => {
      localStorage.setItem("active_chat_id", "0");
      try {
        const rid = parseInt(receiver_id);

        await fetch(`https://fluffycave.nl/api/messages/mark-as-read/${rid}`, {
          method: "POST",
          headers: {
            Authorization: `Bearer ${jwtToken}`,
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ user_id: rid }),
        });

        let count = parseInt(localStorage.getItem("unread_count")) || 0;
        let map = JSON.parse(localStorage.getItem("unread_sender_map") || "{}");

        if (map[rid]) {
          count -= map[rid];
          delete map[rid];
        }

        let chatList = JSON.parse(localStorage.getItem("chat_list") || "[]");
        const index = chatList.findIndex((r) => r.id == rid);
        if (index !== -1) {
          chatList[index].unread_count = 0;
        }

        localStorage.setItem("unread_count", count);
        localStorage.setItem("unread_sender_map", JSON.stringify(map));
        localStorage.setItem("chat_list", JSON.stringify(chatList));

        window.updateGlobalUnreadBadge?.();
        window.refreshUnreadInMatchRows?.();
      } catch (err) {
        console.error("❌ Greška pri mark-as-read:", err);
      }

      localStorage.setItem("active_chat_id", "0");
    });

    return $render;
  };
</script>

<template>
  <div class="page" data-name="job-translated-ai">
    <!-- Navbar -->
    <div class="navbar navbar-fancy">
      <div class="navbar-inner-custom">
        <div class="left">
          <a href="#" class="link back">
            <i class="icon f7-icons">arrow_left</i>
          </a>
        </div>
        <div class="center">
          <img
            src="../assets/circle.svg"
            alt="imjob logo"
            class="navbar-logo-center"
          />
        </div>
        <div class="right">
          <a href="/profile/">
            <img
              src="../assets/setting.png"
              alt="profile"
              class="navbar-profile-icon"
            />
          </a>
        </div>
      </div>
    </div>

    <!-- Page Content -->
    <div class="page-content">
      <div class="block">
        <div id="job-details-content" class="job-card skeleton-block">
          <!-- Job details will load here -->
          <div
            class="skeleton-text skeleton-effect-blink"
            style="width: 80%"
          ></div>
          <div
            class="skeleton-text skeleton-effect-blink"
            style="width: 60%"
          ></div>
          <div
            class="skeleton-text skeleton-effect-blink"
            style="width: 100%"
          ></div>
        </div>

        <!-- Apply Button -->
        <div
          class="block text-align-center"
          id="apply-button-wrapper"
          style="margin-top: 20px; display: none"
        >
          <button id="apply-job-button" class="button button-fill color-blue">
            Apply for this job
          </button>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
      <div class="footer-nav">
        <div class="trty">
          <a href="/main/">
            <img src="../assets/employers.svg" class="ft-img" alt="icon" />
            <p>Home</p>
          </a>
        </div>
        <div class="trty center-button">
          <a href="/ai/">
            <div class="circle-btn">
              <img src="../assets/circle.svg" alt="AI" />
            </div>
          </a>
        </div>
        <div class="trty">
          <a href="/chatList/">
            <img src="../assets/feedback.svg" class="ft-img" alt="icon" />
            <p>Chats</p>
            <span id="unread-badge" class="badge unread-badge">0</span>
          </a>
        </div>
      </div>
    </footer>
  </div>
</template>

<script>
  export default (props, { $f7, $on, $f7route, $ }) => {
    let hasLoaded = false;

    $on("pageInit", async () => {
      if (hasLoaded) return;
      hasLoaded = true;

      const jobId = $f7route.params.id;
      const lang = localStorage.getItem("language_code") || "en";
      const token = localStorage.getItem("jwt_token");

      if (!token) {
        $f7.dialog.alert("Please login first.", "Auth Error");
        $f7router.navigate("/login/");
        return;
      }

      $f7.dialog.preloader("Loading job details...");

      try {
        const res = await fetch(
          `http://127.0.0.1:8000/api/job/${jobId}/translated?lang=${lang}`,
          {
            headers: { Authorization: `Bearer ${token}` },
          }
        );

        const job = await res.json();
        console.log("JOB DETAILS: ",job);
        $f7.dialog.close();

        let html = `
          <div class="card elevation-2">
            <div class="card-content card-content-padding">
              <h2 class="job-title">${job.title}</h2>
              <p class="company-name"><i class="f7-icons">building_2_fill</i> ${
                job.company?.name || "Unknown Company"
              }</p>
              <p><i class="f7-icons">placemark</i> ${job.city}, ${
          job.country
        }</p>
              <p><i class="f7-icons">money_dollar_circle</i> €${
                job.salary_min
              } - €${job.salary_max}</p>
              <p><i class="f7-icons">square_list</i> <b>Category:</b> ${
                job.category
              }</p>
              <p><i class="f7-icons">square_stack_3d_up</i> <b>Subcategory:</b> ${
                job.sub_category
              }</p>
              <div class="job-description">
                <p><b>Description:</b></p>
                <div class="text-medium">${job.description}</div>
              </div>
            </div>
          </div>
        `;

        $("#job-details-content").removeClass("skeleton-block").html(html);
        $("#apply-button-wrapper").show(); // Show apply button

        // Handle Apply Button Click
        $("#apply-job-button").on("click", async () => {
          $f7.dialog.preloader("Sending application...");

          try {
            const token = localStorage.getItem("jwt_token");
            const user = JSON.parse(localStorage.getItem("user"));
            const userId = user?.id;

            const candidatProfileRaw = localStorage.getItem("candidatProfile");
            let candidatProfile;

            try {
              candidatProfile = JSON.parse(candidatProfileRaw);
            } catch (e) {
              candidatProfile = null;
            }

            if (!candidatProfile || !candidatProfile.id) {
              $f7.dialog.alert(
                "You must complete your profile before applying for a job."
              );
              return;
            }

            const candidateId = candidatProfile.id;

            const response = await fetch(
              `http://127.0.0.1:8000/api/job/${jobId}/candidat/${candidateId}/apply`,
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Authorization: `Bearer ${token}`,
                },
              }
            );

            const result = await response.json();

            if (response.ok) {
              $f7.dialog.alert("Successfully applied for the job!", "Success");
              $("#apply-job-button").hide();
            } else if (response.status === 409) {
              $f7.dialog.alert(
                "You have already applied for this job.",
                "Notice"
              );
            } else {
              throw new Error(result.message || "Unknown error");
            }
          } catch (err) {
            console.error(err);
            $f7.dialog.alert(
              "Failed to apply for the job. Try again later.",
              "Error"
            );
          } finally {
            $f7.dialog.close();
          }
        });
      } catch (err) {
        $("#job-details-content").removeClass("skeleton-block").html(`
          <div class="card elevation-2 text-color-red padding">
            <b>Failed to load job details.</b>
          </div>
        `);
        console.error(err);
      }
      finally {
        $f7.dialog.close();
      }
    });

    return $render;
  };
</script>

<style>
  .job-title {
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 5px;
  }

  .company-name {
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 10px;
  }

  .job-description {
    margin-top: 15px;
  }

  .card.elevation-2 {
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border-radius: 12px;
  }

  .text-medium {
    font-size: 15px;
    line-height: 1.5;
  }
  #apply-job-button {
    width: 100% !important;
    max-width: 100%;
    border-radius: 10px !important;
    font-size: 16px;
    margin-top: 40px !important;
  }
</style>

<template>
  <div class="page" data-name="ai">
    <!-- Begin of header -->
    <div class="navbar navbar-fancy">
      <div class="navbar-inner-custom">
        <div class="left">
          <a href="#" class="link icon-only panel-open" data-panel="left">
            <i class="icon f7-icons">menu</i>
          </a>
        </div>

        <div class="center">
          <img
            src="../assets/circle.svg"
            alt="imjob logo"
            class="navbar-logo-center"
          />
        </div>

        <div class="right">
          <a href="/profile/">
            <img
              src="../assets/setting.png"
              alt="profile"
              class="navbar-profile-icon"
            />
          </a>
        </div>
      </div>
    </div>
    <!-- Panel -->
    <div class="panel panel-left panel-reveal">
      <div class="sidebar__close panel-close">
        <i class="icon f7-icons">close</i>
      </div>
      <div class="sidebar__links">
        <div class="sidebar__item">
          <a href="/applyJobs/" class="panel-close" data-transition="f7-push"
            >Apply jobs</a
          >
        </div>
        <div class="sidebar__item">
          <a href="/settings/" class="panel-close" data-transition="f7-push"
            >Settings</a
          >
        </div>
      </div>
    </div>
    <!-- End of header -->
    <!-- Begin of content -->
    <div class="page-content messages-content pt-60 h-80">
      <div class="messages">
        <div class="messages-title" id="ai-timestamp"></div>

        <div class="message message-received">
          <div
            class="message-avatar"
            style="
              background-image: url(http://localhost:5173/assets/circle.svg);
            "
          ></div>
          <div class="message-content">
            <div class="message-name">Im Job Ai</div>
            <div class="message-bubble">
              <div class="message-text">Hello, how can I help you today?</div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      class="toolbar messagebar b-12"
      @messagebar:attachmentdelete="${deleteAttachment}"
    >
      <div class="toolbar-inner">
        <div class="messagebar-area">
          <textarea class="resizable" placeholder="Message"></textarea>
        </div>
        <a
          class="link icon-only demo-send-message-link"
          @click="${sendMessage}"
        >
          <i class="icon f7-icons if-not-md">arrow_up_circle_fill</i>
          <i class="icon material-icons md-only">send</i>
        </a>
      </div>
    </div>
    <!-- Begin of footer -->
    <footer class="footer">
      <div class="footer-nav">
        <div class="trty">
          <a href="/main/">
            <img src="../assets/employers.svg" class="ft-img" alt="icon" />
            <p>Home</p>
          </a>
        </div>
        <div class="trty center-button">
          <a href="/ai/">
            <div class="circle-btn">
              <img src="../assets/circle.svg" alt="AI" />
            </div>
            <!-- <p>AI</p> -->
          </a>
        </div>
        <div class="trty">
          <a href="/chatList/">
            <img src="../assets/feedback.svg" class="ft-img" alt="icon" />
            <p>Chats</p>
            <span id="unread-badge" class="badge unread-badge">0</span>
          </a>
        </div>
      </div>
    </footer>
    <!-- End of footer -->
  </div>
</template>
<style>
  .job-card {
    background: #fff;
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 12px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.07);
    font-size: 14px;
  }

  .job-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 16px;
    margin-bottom: 6px;
  }

  .job-company {
    font-size: 13px;
    color: #666;
  }

  .job-card-body p {
    margin: 4px 0;
  }

  .job-description {
    margin-top: 6px;
    color: #333;
  }

  .job-card-footer {
    margin-top: 10px;
    text-align: right;
  }

  .popup-job-details .block {
    font-size: 16px;
  }

  .popup-job-details .title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .popup-job-details .company-logo {
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
  }

  .popup-job-details h2 {
    margin-top: 8px;
    font-size: 22px;
  }

  .popup-job-details .block-content {
    line-height: 1.6;
    color: #333;
  }

  .popup-job-details ul li {
    padding: 6px 0;
  }

  .popup-job-details .badge {
    border-radius: 20px;
    padding: 4px 12px;
    font-size: 13px;
    background-color: var(--f7-theme-color);
    color: #fff;
    display: inline-block;
  }
</style>
<script>
  export default (props, { $f7, $el, $on, $, $f7router }) => {
    window.updateGlobalUnreadBadge?.();
    const people = [
      {
        name: "Kate Johnson",
        avatar: "https://cdn.framework7.io/placeholder/people-100x100-9.jpg",
      },
      {
        name: "Blue Ninja",
        avatar: "https://cdn.framework7.io/placeholder/people-100x100-7.jpg",
      },
    ];
    const answers = [
      "Yes!",
      "No",
      "Hm...",
      "I am not sure",
      "And what about you?",
      "May be ;)",
      "Lorem ipsum dolor sit amet, consectetur",
      "What?",
      "Are you sure?",
      "Of course",
      "Need to think about it",
      "Amazing!!!",
    ];

    let responseInProgress = false;
    let messagebar;
    let messages;

    const sheetToggle = () => {
      messagebar.sheetToggle();
    };
    const deleteAttachment = (e, index) => {
      var image = messagebar.attachments.splice(index, 1)[0];
      messagebar.renderAttachments();
      checkAttachments();
      // Uncheck in sheet
    };
    const handleAttachment = (e) => {
      var index = $(e.target).parents("label.checkbox").index();
      if (e.target.checked) {
        // Add to attachments
        messagebar.attachments.unshift(image);
      } else {
        // Remove from attachments
        messagebar.attachments.splice(messagebar.attachments.indexOf(image), 1);
      }
      messagebar.renderAttachments();
      checkAttachments();
    };
    const checkAttachments = () => {
      if (messagebar.attachments.length > 0) {
        messagebar.attachmentsShow();
        messagebar.setPlaceholder("Add comment or Send");
      } else {
        messagebar.attachmentsHide();
        messagebar.setPlaceholder("Message");
      }
    };

    const sendMessage = () => {
      var text = messagebar.getValue().replace(/\n/g, "<br />").trim();
      var messagesToSend = [];

      if (!text.length) return;

      // Dodaj korisničku poruku u chat
      messagesToSend.push({ text });

      // Pošalji poruku AI-u
      sendMessageToAI(text);

      // Prikaži poruku korisnika
      messages.addMessages(messagesToSend);

      // Reset UI
      messagebar.attachments = [];
      checkAttachments();
      messagebar.sheetHide();
      messagebar.$sheetEl.find("input").prop("checked", false);
      messagebar.clear();
      messagebar.focus();
    };

    const sendMessageToAI = async (messageText) => {
      const token = localStorage.getItem("jwt_token");

      // Prikaži typing pre slanja
      messages.showTyping({
        header: "ImJob AI is typing...",
        avatar: "../assets/images/ai.png",
      });

      try {
        const res = await fetch("http://127.0.0.1:8000/api/chat/search", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + token,
          },
          body: JSON.stringify({
            message: messageText,
          }),
        });

        const data = await res.json();
        messages.hideTyping();
        localStorage.setItem("language_code", data.language_code);

        if (data.message) {
          messages.addMessage({
            text: data.message,
            type: "received",
            name: "JobAI",
            avatar: "http://localhost:5173/assets/circle.svg",
          });

          // Ako ima i job listinge
          if (Array.isArray(data.jobs) && data.jobs.length) {
            data.jobs.forEach((job) => {
              const url = new URL(job.link);
              const relativePath = url.pathname;

              const messageHtml = `
              <div class="job-card">
                <div class="job-card-header">
                  <b>${job.title}</b>
                  <span class="job-company">${job.company}</span>
                </div>
                <div class="job-card-body">
                  <p><b>Location:</b> ${job.city}, ${job.country}</p>
                  <p><b>Category:</b> ${job.category} <br> <b>Sub:</b> ${job.sub_category}</p>
                </div>
                <div class="job-card-footer">
                 <a href="#" class="view-job-details" data-id="${job.id}">View Details</a>
                </div>
              </div>
            `;

              messages.addMessage({
                text: messageHtml,
                type: "received",
                name: "JobBot",
                avatar: "../assets/images/ai.png",
              });
            });

            // Dodaj listener nakon što su poruke ubačene
            setTimeout(() => {
              document.querySelectorAll(".view-job-details").forEach((btn) => {
                btn.addEventListener("click", async (e) => {
                  e.preventDefault();
                  const jobId = btn.getAttribute("data-id");
                  const langCode =
                    localStorage.getItem("language_code") || "en"; // koristi ono što već imaš

                  try {
                    // $f7.dialog.preloader("Go to next page...");
                    const res = await fetch(
                      `http://127.0.0.1:8000/api/job/${jobId}/translated?lang=${langCode}`,
                      {
                        headers: {
                          Authorization:
                            "Bearer " + localStorage.getItem("jwt_token"),
                        },
                      }
                    );
                    const job = await res.json();

                    // $f7.dialog.close();
                    if (job.id) {
                      $f7router.navigate(`/job/ai/translated/${job.id}/`);
                    } else {
                      $f7.dialog.alert("Job not found.");
                    }
                  } catch (err) {
                    console.error("Error fetching job:", err);
                    // $f7.dialog.close();
                    $f7.dialog.alert(
                      "Something went wrong while loading job details."
                    );
                  }
                });
              });
            }, 100);
          }
        } else {
          messages.addMessage({
            text: "Sorry, I didn't get that.",
            type: "received",
          });
        }
      } catch (err) {
        console.error("AI error:", err);
        messages.hideTyping();
        messages.addMessage({
          text: "AI error. Please try again.",
          type: "received",
        });
      }
    };

    const fetchHistory = async () => {
      const token = localStorage.getItem("jwt_token");

      try {
        const res = await fetch("http://127.0.0.1:8000/api/chat/history", {
          headers: {
            Authorization: "Bearer " + token,
          },
        });

        const history = await res.json();

        history.reverse().forEach((item) => {
          // Korisnička poruka
          messages.addMessage({
            text: item.user_message,
            type: "sent",
          });

          // AI odgovor
          messages.addMessage({
            text: item.ai_response,
            type: "received",
            name: "JobAI",
            avatar: "http://localhost:5173/assets/circle.svg",
          });

          // Poslovi
          if (Array.isArray(item.jobs)) {
            item.jobs.forEach((job) => {
              const jobHtml = `
            <div class="job-card">
              <div class="job-card-header">
                <b>${job.title}</b>
                <span class="job-company">${job.company}</span>
              </div>
              <div class="job-card-body">
                <p><b>Location:</b> ${job.city}, ${job.country}</p>
                <p><b>Category:</b> ${job.category} <br> <b>Sub:</b> ${job.sub_category}</p>
              </div>
              <div class="job-card-footer">
                <a href="#" class="view-job-details" data-id="${job.id}">View Details</a>
              </div>
            </div>
          `;
              messages.addMessage({
                text: jobHtml,
                type: "received",
                name: "JobBot",
                avatar: "../assets/ai-avatar.png",
              });
            });
          }
        });

        // Reaktiviraj View Details dugmiće
        setTimeout(() => {
          document.querySelectorAll(".view-job-details").forEach((btn) => {
            btn.addEventListener("click", async (e) => {
              e.preventDefault();
              const jobId = btn.getAttribute("data-id");
              const langCode = localStorage.getItem("language_code") || "en";
              try {
                const res = await fetch(
                  `http://127.0.0.1:8000/api/job/${jobId}/translated?lang=${langCode}`,
                  {
                    headers: {
                      Authorization: "Bearer " + token,
                    },
                  }
                );

                const job = await res.json();

                if (job.id) {
                  $f7router.navigate(`/job/ai/translated/${job.id}/`);
                } else {
                  $f7.dialog.alert("Job not found.");
                }
              } catch (err) {
                console.error("Error fetching job:", err);
                $f7.dialog.alert(
                  "Something went wrong while loading job details."
                );
              }
            });
          });
        }, 100);
      } catch (err) {
        console.error("Failed to fetch AI history:", err);
      }
    };

    $on("pageInit", () => {
      const jwtToken = localStorage.getItem("jwt_token");

      if (!jwtToken) {
        localStorage.clear();

        const dialog = $f7.dialog.create({
          title: "Auth Error",
          text: "You are not logged in. Please login to continue.",
          buttons: [
            {
              text: "OK",
              bold: true,
              onClick: () => {
                $f7router.navigate("/login");
              },
            },
          ],
          closeByBackdropClick: false,
        });

        dialog.open();
        return;
      }

      messagebar = $f7.messagebar.create({
        el: $el.value.find(".messagebar"),
        attachments: [],
      });

      messages = $f7.messages.create({
        el: $el.value.find(".messages"),
        firstMessageRule: function (message, previousMessage, nextMessage) {
          if (message.isTitle) return false;
          if (
            !previousMessage ||
            previousMessage.type !== message.type ||
            previousMessage.name !== message.name
          )
            return true;
          return false;
        },
        lastMessageRule: function (message, previousMessage, nextMessage) {
          if (message.isTitle) return false;
          if (
            !nextMessage ||
            nextMessage.type !== message.type ||
            nextMessage.name !== message.name
          )
            return true;
          return false;
        },
        tailMessageRule: function (message, previousMessage, nextMessage) {
          if (message.isTitle) return false;
          if (
            !nextMessage ||
            nextMessage.type !== message.type ||
            nextMessage.name !== message.name
          )
            return true;
          return false;
        },
      });

      //   messages.addMessage({
      //   text: 'Loading previous conversations...',
      //   type: 'received',
      // });
      fetchHistory();
      // ✅ Ovde dodaješ dinamički timestamp
      const now = new Date();
      const options = { weekday: "long", month: "short", day: "numeric" };
      const formattedDate = now.toLocaleDateString("en-US", {
        weekday: "long",
        month: "short",
        day: "numeric",
      });
      $("#ai-timestamp").html(`<b>${formattedDate}</b>`);
    });

    $on("pageBeforeRemove", () => {
      messagebar.destroy();
      messages.destroy();
    });

    return $render;
  };
</script>

<script>
export default (props, { $, $on, $f7, $f7router }) => {
  $on("page:init", () => {
    const jwtToken = localStorage.getItem("jwt_token");
    if (!jwtToken) {
      $f7.dialog.alert("You are not logged in. Please login to continue.", "Auth Error");
      $f7router.navigate("/login/");
      return;
    }
  });

  // ✅ This correctly hooks into the <template> above
  return $render;
};
</script>

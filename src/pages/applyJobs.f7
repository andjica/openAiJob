<template>
  <div class="page" data-name="recruiterJob">
  <!-- Header -->
    <div class="navbar navbar-fancy">
      <div class="navbar-inner-custom">
        <div class="left">
          <a href="#" class="link icon-only panel-open" data-panel="left">
            <i class="icon f7-icons">menu</i>
          </a>
        </div>
        <div class="center">
          <img src="../assets/circle.svg" alt="imjob logo" class="navbar-logo-center" />
        </div>
        <div class="right">
          <a href="/profile/">
            <img src="../assets/setting.png" alt="profile" class="navbar-profile-icon" />
          </a>
        </div>
      </div>
    </div>

    <!-- Panel -->
    <div class="panel panel-left panel-reveal">
      <div class="sidebar__close panel-close">
        <i class="icon f7-icons">close</i>
      </div>
      <div class="sidebar__links">
        <div class="sidebar__item">
          <a href="/applyJobs/" class="panel-close" data-transition="f7-push">Apply jobs</a>
        </div>
        <div class="sidebar__item">
          <a href="/settings/" class="panel-close" data-transition="f7-push">Settings</a>
        </div>
      </div>
    </div>

    <!-- Begin of Content -->
    <div class="block">
      <div class="jobs-recrtuter mt-80">
        <div id="job-post" class="job-scroll"></div>
      </div>
    </div>
    <!-- End of Content -->
    <!-- Begin of footer -->
   <footer class="footer">
  <div class="footer-nav">
    <div class="trty">
      <a href="/main/">
        <img src="../assets/employers.svg" class="ft-img" alt="icon" />
        <p>Home</p>
      </a>
    </div>
    <div class="trty center-button">
      <a href="/ai/">
        <div class="circle-btn">
          <img src="../assets/circle.svg" alt="AI" />
        </div>
        <!-- <p>AI</p> -->
      </a>
    </div>
    <div class="trty">
      <a href="/chatList/">
        <img src="../assets/feedback.svg" class="ft-img" alt="icon" />
        <p>Chats</p>
        <span id="unread-badge" class="badge unread-badge">0</span>
      </a>
    </div>
  </div>
</footer>
    <!-- End of footer -->
  </div>
</template>

<style>
  .jobs-recrtuter {
    position: relative;
  }

  .job-scroll {
    max-height: calc(100vh - 120px); /* Ili koristi calc() ako treba više kontrole */
    overflow-y: auto;
    padding-right: 8px;
  }

  .job-post__details {
    padding: 5px;
    border: 1px solid #ddd;
    background-color: #f9f9f9;
  }

  .job-post__card {
    padding: 16px;
    margin-bottom: 20px;
    border-radius: 12px;
    border: 1px solid #e0e0e0;
    background-color: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
  }

  .job-post__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .job-title {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }

  .company-logo {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 50%;
  }

  .job-subtitle {
    font-size: 14px;
    color: #666;
    margin-top: 6px;
  }

  .job-post__status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 12px 0;
  }

  .chat-icon {
    width: 24px;
    height: 24px;
  }

  .job-location,
  .job-company {
    font-size: 14px;
    margin-bottom: 4px;
  }

  .view-process-btn {
    margin-top: 10px;
    width: 100%;
    background: #007bff;
  }

  .btn {
    border-radius: 30px;
    border: none;
    width: 100px;
    height: 36px;
  }

  .btn__pedding {
    background-color: #ebbf6c;
  }

  .btn__process {
    background-color: #21ec21;
  }
</style>

<script>
  export default (props, { $, $on, $f7, $f7router }) => {
    $on("page:init", () => {
      const jwtToken = localStorage.getItem("jwt_token");
      window.updateGlobalUnreadBadge?.();
      let jobs = [];

      if (!jwtToken) {
        $f7.dialog.alert(
          "You are not logged in. Please login to continue.",
          "Auth Error"
        );
        $f7router.navigate("/login/");
        return;
      }
      
      const fetchApplyJob = () => {
        $f7.dialog.preloader("Loading applied jobs...");
        fetch(`http://127.0.0.1:8000/api/applied-jobs`, {
          method: "GET",
          headers: {
            Authorization: `Bearer ${jwtToken}`,
          },
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error("Network response was not ok");
            }
            return response.json();
          })
          .then((data) => {
            console.log()
            jobs = data.jobs;
            displayApplyJobs(jobs);
          })
          .catch((error) => {
            console.error("Fetch error:", error);
            $f7.dialog.alert("Something wrong to fetch", "Error");
          })
          .finally(() => {
            // ✅ Always close the preloader
            $f7.dialog.close();
          });
      };

      const displayApplyJobs = (jobs) => {
        const jobPosts = document.querySelector("#job-post");
        jobPosts.innerHTML = ""; // clear any existing posts

        if (jobs.length > 0) {
          jobs.forEach((jobWrapper) => {
            const status =
              jobWrapper.pivot.status === "accept"
                ? `<div class="status__accept"><button class="btn btn__process">In recruiter process</button><a href="/chatroom/${jobWrapper.recruiter.user_id}" class="chat-link"><img src="../assets/feedback.svg" alt="Chat" class="chat-icon"/></a></div>`
                : '<button class="btn btn__pedding" disabled>In pending</button>';

            const linkToProccess = `
        <button 
          class="button button-small button-fill view-process-btn" 
          data-job-id="${jobWrapper.pivot.id}" 
          data-status="${jobWrapper.pivot.status}"
        >
          View Process
        </button>`;

            const national =
              jobWrapper.job_world_type === "national"
                ? '<span class="badge color-orange">national</span>'
                : '<span class="badge color-blue">international</span>';

            const companyLogo = jobWrapper.company?.logo
              ? `http://127.0.0.1:8000/storage/${jobWrapper.company.logo}`
              : "";

            const logoHTML = companyLogo
              ? `<img src="${companyLogo}" alt="Company" class="company-logo" />`
              : "";

            const jobHTML = `
        <div class="job-post__card">
          <div class="job-post__header">
            ${national}
            ${logoHTML}
          </div>
          <h3 class="job-title">${jobWrapper.title}</h3>
          <p class="job-subtitle">${jobWrapper.category.name}, ${
              jobWrapper.sub_category.name
            }</p>
          <div class="job-post__status">
            ${status}
          </div>
          <p class="job-location">${jobWrapper.country.name}, ${
              jobWrapper.city.name
            }</p>
          <p class="job-company">Company: <strong>${
            jobWrapper.company?.name ?? "Company name"
          }</strong></p>
          ${linkToProccess}
        </div>
      `;

            jobPosts.insertAdjacentHTML("beforeend", jobHTML);
          });

          // ✅ AFTER all job HTML is rendered:
          const viewButtons = jobPosts.querySelectorAll(".view-process-btn");
          viewButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
              const status = btn.dataset.status;
              const jobId = btn.dataset.jobId;

              if (status === "accept") {
                $f7router.navigate(`/recruitment/status/${jobId}`);
              } else {
                $f7.dialog.alert("The process is not started");
              }
            });
          });
        } else {
          const jobHTML = `
      <div class="job-post__card">
        <h4>You didn't apply in any jobs</h4>
      </div>`;
          jobPosts.innerHTML = jobHTML;
        }
      };

      fetchApplyJob();
    });

    return $render;
  };
</script>
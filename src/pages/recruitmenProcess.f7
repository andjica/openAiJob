<template>
  <div class="page" data-name="recruitmenProcess">
    <div class="navbar navbar-fancy">
  <div class="navbar-inner-custom">
    <div class="left">
      <a href="#" class="link back">
        <i class="icon f7-icons">arrow_left</i>
      </a>
    </div>

    <div class="center">
      <img src="../assets/circle.svg" alt="imjob logo" class="navbar-logo-center" />
    </div>

    <div class="right">
      <a href="/profile/">
        <img src="../assets/setting.png" alt="profile" class="navbar-profile-icon" />
      </a>
    </div>
  </div>
</div>
    <div class="block mt-80">
      <div class="phases">
        <h2 id="selection-title">Selection Phase</h2>
        <div id="selection-phase"></div>

        <h2 id="offer-title">Offer Stage</h2>
        <div id="offer-stage"></div>
      </div>
    </div>
   <footer class="footer">
  <div class="footer-nav">
    <div class="trty">
      <a href="/main/">
        <img src="../assets/employers.svg" class="ft-img" alt="icon" />
        <p>Home</p>
      </a>
    </div>
    <div class="trty center-button">
      <a href="/ai/">
        <div class="circle-btn">
          <img src="../assets/circle.svg" alt="AI" />
        </div>
        <!-- <p>AI</p> -->
      </a>
    </div>
    <div class="trty">
      <a href="/chatList/">
        <img src="../assets/feedback.svg" class="ft-img" alt="icon" />
        <p>Chats</p>
        <span id="unread-badge" class="badge unread-badge">0</span>
      </a>
    </div>
  </div>
</footer>
  </div>
</template>

<style>
  .phases {
    overflow-y: auto;
    max-height: 568px;
  }

  .current-phase {
    border: 2px solid #21ec21 !important;
  }

  .phases__card-content {
    padding: 10px;
    border-radius: 12px;
    border: 1px solid #e0e0e0;
    background-color: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
  }

  .phases__card-content h3 {
    text-align: center;
    padding: 5px 0;
  }

  .phases__link {
    text-align: center;
  }
</style>

<script>
  export default (props, { $, $f7, $on, $f7router }) => {
    $on("pageInit", async () => {
      const jobId = $f7router.currentRoute.params.id;
      console.log("Job id: ", jobId);
      const jwtToken = localStorage.getItem("jwt_token");
      
      if (!jwtToken) {
        localStorage.clear();

        const dialog = $f7.dialog.create({
          title: 'Auth Error',
          text: 'You are not logged in. Please login to continue.',
          buttons: [
            {
              text: 'OK',
              bold: true,
              onClick: () => {
                $f7router.navigate('/login');
              }
            }
          ],
          closeByBackdropClick: false
        });

        dialog.open();
        return;
      }

      window.updateGlobalUnreadBadge?.();

      const fetchRecruitmentJobProcess = () => {
        $f7.dialog.preloader("Loading phases process...");
        fetch(`http://127.0.0.1:8000/api/recruitment/status/${jobId}`, {
          method: "GET",
          headers: {
            Authorization: `Bearer ${jwtToken}`,
          },
        })
          .then((response) => {
            if (!response.ok) {
              throw new Error("Network response was not ok");
            }
            return response.json();
          })
          .then((data) => {
            const recruitmentProcess = data;
            console.log("Recruitment Process: ", recruitmentProcess);
            const selectionPhases = recruitmentProcess.subphases.filter(
              (sub) => sub.phase === "selection"
            );
            const offerPhases = recruitmentProcess.subphases.filter(
              (sub) => sub.phase === "offer_stage"
            );

            const selectionTitle = document.getElementById("selection-title");
            const offerTitle = document.getElementById("offer-title");

            const isPhaseFinished = (phases) =>
              phases.length > 0 && phases.every((p) => p.completed === 1);

            const currentPhase = recruitmentProcess.current_phase;

            if (isPhaseFinished(selectionPhases)) {
              selectionTitle.textContent += " - finished";
            }
            if (currentPhase === "selection") {
              selectionTitle.textContent += " - current";
            }

            // OFFER STAGE
            if (isPhaseFinished(offerPhases)) {
              offerTitle.textContent += " - finished";
            }
            if (currentPhase === "offer_stage") {
              offerTitle.textContent += " - current";
            }

            const currentSubphase = recruitmentProcess.current_subphase;

            const renderSubphases = (targetId, subphases) => {
              const container = document.querySelector(targetId);
              container.innerHTML = "";

              if (subphases.length === 0) {
                container.innerHTML = "<p>No items in this phase.</p>";
                return;
              }

              subphases.forEach((sub) => {
                const feedback = sub?.completed
                  ? `<p><strong>Feedback:</strong> ${sub.feedback ?? "N/A"}</p>`
                  : "";
                const isCurrent = sub.completed ? "" : "current-phase";

                const html = ` <div class="card">
          <div class="phases__card-content ${isCurrent}">
            <h3>${sub.subphase_name}</h3>
            <p><strong>Title:</strong> ${sub.meeting_title}</p>
            <p><strong>Scheduled at:</strong> ${sub.scheduled_at}</p>
            <p><strong>Completed:</strong> ${sub.completed ? "Yes" : "No"}</p>
            ${feedback}
            <p class="phases__link"><a href="${
              sub.meeting_link
            }" target="_blank">Meeting Link</a></p>
          </div>
        </div>`;

                container.insertAdjacentHTML("beforeend", html);
              });
            };
            renderSubphases("#selection-phase", selectionPhases);
            renderSubphases("#offer-stage", offerPhases);
          })
          .catch((error) => {
            console.error("Fetch error:", error);
            $f7.dialog.alert("Something wrong to fetch", "Error");
          })
          .finally(() => {
            // ✅ Always close the preloader
            $f7.dialog.close();
          });
      };

      fetchRecruitmentJobProcess();
    });

    return $render;
  };
</script>

<template>
  <div class="page" data-name="jobdetails">
    <div class="navbar navbar-fancy">
      <div class="navbar-inner-custom">
        <div class="left">
          <a href="#" class="link back">
            <i class="icon f7-icons">arrow_left</i>
          </a>
        </div>
        <div class="center">
          <img src="../assets/circle.svg" class="navbar-logo-center" alt="logo" />
        </div>
        <div class="right">
          <a href="/profile/">
            <img src="../assets/setting.png" class="navbar-profile-icon" alt="profile" />
          </a>
        </div>
      </div>
    </div>

    <div class="page-content">
      <div class="block">
        <div id="job-details-content" class="job-card__details skeleton-block">
          <div class="skeleton-text skeleton-effect-blink" style="width: 80%"></div>
          <div class="skeleton-text skeleton-effect-blink" style="width: 60%"></div>
          <div class="skeleton-text skeleton-effect-blink" style="width: 100%"></div>
        </div>

        <div class="block text-align-center" id="apply-button-wrapper" style="display:none; margin-top: 20px;">
          <button id="apply-job-button" class="button button-fill color-blue">Apply for this job</button>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
  export default (props, { $f7, $on, $f7route, $ }) => {
    $on('pageInit', async () => {
      const jobId = $f7route.params.id;
      const token = localStorage.getItem("jwt_token");
      const lang = localStorage.getItem("language_code") || "en";

      if (!token) {
        $f7.dialog.alert("Please login first.", "Auth Error");
        return $f7router.navigate('/login/');
      }

      $f7.dialog.preloader("Loading details of job...");

      try {
        const res = await fetch(`http://127.0.0.1:8000/api/job/${jobId}/translated?lang=${lang}`, {
          headers: { Authorization: `Bearer ${token}` }
        });

        if (!res.ok) throw new Error("Failed to fetch job");

        const job = await res.json();
        console.log("Active Job",job);
        let html = `
          <div class="card elevation-2">
            <div class="card-content card-content-padding">
              <h2 class="job-title">${job.title ?? 'Untitled Job'}</h2>
              <p class="company-name"><i class="f7-icons">building_2_fill</i> ${job?.company ?? "Company"}</p>
              <p><i class="f7-icons">placemark</i> ${job.city ?? '-'}, ${job.country ?? '-'}</p>
              <p><i class="f7-icons">money_dollar_circle</i> €${job.salary_min ?? 0} - €${job.salary_max ?? 0}</p>
              <p><i class="f7-icons">person_2_fill</i> <b>Experience Level:</b> ${job.experience_level ?? "N/A"}</p>
              <p><i class="f7-icons">person_crop_circle</i> <b>Age Range:</b> ${job.min_age ?? "-"} - ${job.max_age ?? "-"}</p>
              <p><i class="f7-icons">checkmark_shield</i> <b>Special Requirements:</b> ${job.special_requirements ?? "None"}</p>
              <p><i class="f7-icons">calendar</i> <b>Valid Until:</b> ${job.valid_until ?? '-'}</p>
              <p><i class="f7-icons">globe</i> <b>World Type:</b> ${job.job_world_type ?? '-'}</p>
              <p><i class="f7-icons">textformat</i> <b>Language:</b> ${(job.language_code ?? 'en').toUpperCase()}</p>
              <p><i class="f7-icons">list_number</i> <b>Category:</b> ${job.category?.name ?? '-'}</p>
              <p><i class="f7-icons">layers_alt</i> <b>Subcategory:</b> ${job.sub_category?.name ?? '-'}</p>
              <div class="job-description">
                <p><b>Description:</b></p>
                <div class="text-medium">${job.description ?? 'No description available.'}</div>
              </div>
            </div>
          </div>
        `;

        $('#job-details-content').removeClass('skeleton-block').html(html);
        $('#apply-button-wrapper').show();

        $('#apply-job-button').on('click', async () => {
          $f7.dialog.preloader("Sending application...");

          try {
         const token = localStorage.getItem('jwt_token');
          const user = JSON.parse(localStorage.getItem('user'));
          const userId = user?.id;

          const candidatProfileRaw = localStorage.getItem('candidatProfile');
          let candidatProfile;

          try {
            candidatProfile = JSON.parse(candidatProfileRaw);
          } catch (e) {
            candidatProfile = null;
          }

          if (!candidatProfile || !candidatProfile.id) {
            $f7.dialog.alert('You must complete your profile before applying for a job.');
            return;
          }

          const candidateId = candidatProfile.id;
          
          const response = await fetch(`http://127.0.0.1:8000/api/job/${jobId}/candidat/${candidateId}/apply`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              'Authorization': `Bearer ${token}`
            }
          });

          const res = await response.json();

            if (response.ok) {
              $f7.dialog.alert("You have successfully applied!", "Success");
              $('#apply-job-button').hide();
            } else if (response.status === 409) {
              $f7.dialog.alert("You already applied to this job.", "Notice");
            } else {
              const err = await response.json();
              throw new Error(err.message || "Failed to apply");
            }
          } catch (e) {
            console.error(e);
            $f7.dialog.alert("Error applying for job", "Error");
          } finally {
            $f7.dialog.close();
          }
        });

      } catch (e) {
        $('#job-details-content').removeClass('skeleton-block').html(`<div class="text-color-red padding">Failed to load job details.</div>`);
        console.error(e);
      } 
      finally {
        $f7.dialog.close();
      }
    });

    return $render;
  };
</script>

<style>
  .job-card__details.skeleton-block {
    background: none!important;
  }
  .job-title {
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 5px;
  }

  .company-name {
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 10px;
  }

  .job-description {
    margin-top: 15px;
  }

  .card.elevation-2 {
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    border-radius: 12px;
  }

  .text-medium {
    font-size: 15px;
    line-height: 1.5;
  }

  #apply-job-button {
    width: 90%;
    max-width: 300px;
    border-radius: 30px;
    font-size: 16px;
  }
</style>

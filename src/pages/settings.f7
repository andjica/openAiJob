<template>
  <div class="page" data-name="settings">
   <!-- Header -->
    <div class="navbar navbar-fancy">
      <div class="navbar-inner-custom">
        <div class="left">
          <a href="#" class="link icon-only panel-open" data-panel="left">
            <i class="icon f7-icons">menu</i>
          </a>
        </div>
        <div class="center">
          <img src="../assets/circle.svg" alt="imjob logo" class="navbar-logo-center" />
        </div>
        <div class="right">
          <a href="/profile/">
            <img src="../assets/setting.png" alt="profile" class="navbar-profile-icon" />
          </a>
        </div>
      </div>
    </div>
    <div class="block pt-30">
      <div class="list list-strong-ios list-dividers-ios inset-ios">
        <form id="uploadEmail" class="form__settings">
          <div class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">Email</div>
              <div class="item-input-wrap">
                <input id="email-input" type="text" placeholder="Your email" />
                <span class="input-clear-button"></span>
              </div>
            </div>
          </div>

          <button id="update-email-btn" class="button button-upload">
            Update Email
          </button>
        </form>

        <form id="uploadPassword" class="form__settings">
          <div class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">Password</div>
              <div class="item-input-wrap">
                <input
                  id="current-password"
                  type="password"
                  placeholder="Current password"
                />
                <span class="input-clear-button"></span>
              </div>
            </div>
          </div>
          <div class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">New Password</div>
              <div class="item-input-wrap">
                <input
                  id="new-password"
                  type="password"
                  placeholder="Your new password"
                />
                <span class="input-clear-button"></span>
              </div>
            </div>
          </div>
          <div class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">Confirm New Password</div>
              <div class="item-input-wrap">
                <input
                  id="confirm-password"
                  type="password"
                  placeholder="Confirm new password"
                />
                <span class="input-clear-button"></span>
              </div>
            </div>
          </div>
          <button id="update-password-btn" class="button button-upload">
            Update Password
          </button>
        </form>
      </div>
    </div>
    <!-- Footer -->
    <footer class="footer">
      <div class="footer-nav">
        <div class="trty">
          <a href="/main/">
            <img src="../assets/employers.svg" class="ft-img" alt="icon" />
            <p>Home</p>
          </a>
        </div>
        <div class="trty center-button">
          <a href="/ai/">
            <div class="circle-btn">
              <img src="../assets/circle.svg" alt="AI" />
            </div>
          </a>
        </div>
        <div class="trty">
          <a href="/chatList/">
            <img src="../assets/feedback.svg" class="ft-img" alt="icon" />
            <p>Chats</p>
            <span id="unread-badge" class="badge unread-badge">0</span>
          </a>
        </div>
      </div>
    </footer>
  </div>
</template>

<script>
  export default (props, { $, $f7, $on, $f7router }) => {
    $on("pageInit", () => {
      const user = JSON.parse(localStorage.getItem("user") || "{}");
      const jwtToken = localStorage.getItem("jwt_token");
      console.log(user);
      if (!jwtToken) {
        $f7.dialog.alert(
          "You are not logged in. Please login to continue.",
          "Auth Error"
        );
        localStorage.clear();
        $f7router.navigate("/login");
        return;
      }

      let originalEmail = user.email || "";
      $("#email-input").val(originalEmail);

      const $emailInput = $("#email-input");
      const $currentPassword = $("#current-password");
      const $newPassword = $("#new-password");
      const $confirmPassword = $("#confirm-password");
      const $updatePasswordBtn = $("#update-password-btn");

      $("#uploadEmail").on("submit", (e) => {
        e.preventDefault();

        const newEmail = $emailInput.val().trim();
        const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (!newEmail) {
          $f7.dialog.alert("Email is required.", "Validation Error");
          return;
        } else if (!re.test(newEmail)) {
          $f7.dialog.alert("Email is not valid!");
          return;
        } else if(newEmail === originalEmail) {
          $f7.dialog.alert("Email has not change.", "No Update Needed");
          return;
        }

        showConfirmEmailDialog(newEmail);
      });

      function showConfirmEmailDialog(email) {
        $f7.dialog
          .create({
            title: "Confirm Email Change",
            text: `Are you sure you want to update your email to <b>${email}</b>?`,
            buttons: [
              {
                text: "No",
                color: "red",
                onClick: () => {
                  console.log("User canceled email update");
                  $emailInput.val(originalEmail);
                },
              },
              {
                text: "Yes",
                close: true,
                onClick: () => {
                  updateEmail(email);
                },
              },
            ],
            verticalButtons: false,
          })
          .open();
      }

      function updateEmail(email) {
        console.log("Email updated to:", email);
        const user = JSON.parse(localStorage.getItem("user"));
        localStorage.setItem("newEmail", email);
        fetch(`http://127.0.0.1:8000/api/verify-user/${user.id}/resend-code`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: user.email }),
        });

        $f7router.navigate("/verifyUpdate/");
      }

      $("#uploadPassword").on("submit", (e) => {
        e.preventDefault();
        const password = $currentPassword.val().trim();
        const newPassword = $newPassword.val().trim();
        const confirmPassword = $confirmPassword.val().trim();

        const errors = [];

        if (!password) {
          errors.push("Current password is required!");
        } else if (password.length < 6) {
          errors.push("Current password must be at least 6 characters.");
        }

        if (!newPassword) {
          errors.push("New password is required!");
        } else if (newPassword.length < 6) {
          errors.push("New password must be at least 6 characters.");
        }

        if (!confirmPassword) {
          errors.push("Confirm password is required!");
        } else if (confirmPassword.length < 6) {
          errors.push("Confirm password must be at least 6 characters.");
        }

        if (newPassword !== confirmPassword) {
          errors.push("New password and confirm password do not match.");
        }

        updatePassword(errors, password, newPassword);
      });

      async function updatePassword(errors, password, newPassword) {
        if (errors.length > 0) {
          $f7.dialog.alert(errors.join("<br>"), "Validation Error");
          return;
        }

        try {
          const url = `http://127.0.0.1:8000/api/update-password`;
          const response = await fetch(url, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${jwtToken}`,
            },
            body: JSON.stringify({
              current_password: password,
              new_password: newPassword,
              confirm_password: newPassword,
            }),
          });

          const data = await response.json();
          console.log(data);
          if (response.ok) {
            $f7.dialog.alert(
              data.message,
              "Success"
            );

            // Clear input fields if you're using jQuery references like:
            $("#currentPassword").val("");
            $("#newPassword").val("");
            $("#confirmPassword").val("");

            $f7router.navigate("/main/");
          } else {
            $f7.dialog.alert(
              data.error || "Failed to update password.",
              "Error"
            );
          }
        } catch (error) {
          console.error("Password update error:", error);
          $f7.dialog.alert("Something went wrong. Please try again.", "Error");
        }
      }
    });

    return $render;
  };
</script>

<style>
  .form__settings {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .form__settings .item-content {
    width: 100%;
  }

  .button-upload {
    margin-top: 10px;
    background-color: #007bff;
    color: white;
    width: 200px;
  }
</style>

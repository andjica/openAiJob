<template>
  <div class="page" data-name="settings">
    <div class="navbar navbar-large">
      <div class="navbar-bg"></div>
      <div class="navbar-inner">
        <div class="left">
          <a id="backLink" href="#" class="link back">
            <i class="icon icon-back"></i>
          </a>
        </div>
        <div class="title-large setting__title">
          <div class="title-large-text pl-0" id="settingsTitle">Settings</div>
        </div>
      </div>
    </div>
    <div class="block pt-30">
      <div class="list list-strong-ios list-dividers-ios inset-ios">
        <form id="uploadEmail" class="form__settings">
          <div class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">Email</div>
              <div class="item-input-wrap">
                <input id="email-input" type="text" placeholder="Your email" />
                <span class="input-clear-button"></span>
              </div>
            </div>
          </div>

          <button id="update-email-btn" class="button button-upload">
            Update Email
          </button>
        </form>

        <form id="uploadPassword" class="form__settings">
          <div class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">Password</div>
              <div class="item-input-wrap">
                <input
                  id="current-password"
                  type="password"
                  placeholder="Current password"
                />
                <span class="input-clear-button"></span>
              </div>
            </div>
          </div>
          <div class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">New Password</div>
              <div class="item-input-wrap">
                <input
                  id="new-password"
                  type="password"
                  placeholder="Your new password"
                />
                <span class="input-clear-button"></span>
              </div>
            </div>
          </div>
          <div class="item-content item-input">
            <div class="item-inner">
              <div class="item-title item-label">Confirm New Password</div>
              <div class="item-input-wrap">
                <input
                  id="confirm-password"
                  type="password"
                  placeholder="Confirm new password"
                />
                <span class="input-clear-button"></span>
              </div>
            </div>
          </div>
          <button
            id="update-password-btn"
            class="button button-upload"
          >
            Update Password
          </button>
        </form>
      </div>
    </div>
  </div>
</template>

<script>
  export default (props, { $, $f7, $on, $f7router }) => {
    $on("pageInit", () => {
      const user = JSON.parse(localStorage.getItem("user") || "{}");
      let originalEmail = user.email || "";
      $("#email-input").val(originalEmail);

      const $emailInput = $("#email-input");
      const $currentPassword = $("#current-password");
      const $newPassword = $("#new-password");
      const $confirmPassword = $("#confirm-password");
      const $updatePasswordBtn = $("#update-password-btn");

      $("#uploadEmail").on("submit", (e) => {
        e.preventDefault();

        const newEmail = $emailInput.val().trim();
        const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (!newEmail) {
          $f7.dialog.alert("Email is required.", "Validation Error");
          return;
        }else if(!re.test(newEmail)) {
          $f7.dialog.alert("Email is not valid!");
          return;
        }

        showConfirmEmailDialog(newEmail);
      });

      function showConfirmEmailDialog(email) {
        $f7.dialog.create({
          title: "Confirm Email Change",
          text: `Are you sure you want to update your email to <b>${email}</b>?`,
          buttons: [
            {
              text: "No",
              color: "red",
              onClick: () => {
                console.log("User canceled email update");
                $emailInput.val(originalEmail);
              },
            },
            {
              text: "Yes",
              close: true,
              onClick: () => {
                updateEmail(email);
              },
            },
          ],
          verticalButtons: false,
        }).open();
      }

      function updateEmail(email) {
        console.log("Email updated to:", email);
        $f7.dialog.alert("Email has been updated!", "Success");

        // Optionally save to localStorage
        // const user = JSON.parse(localStorage.getItem("user") || "{}");
        // user.email = email;
        // localStorage.setItem("user", JSON.stringify(user));
        localStorage.setItem("newEmail", originalEmail);
        localStorage.setItem("userVerify", 0);
        fetch(`http://127.0.0.1:8000/api/verify/resend/${user.id}`, {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ email: user.email }),
                });

                $f7router.navigate("/verify/");
                console.log("Email updated to:", originalEmail);
      }

      
      $("#uploadPassword").on("submit", (e) => {
        e.preventDefault();
        const password = $currentPassword.val().trim();
        const newPassword = $newPassword.val().trim();
        const confirmPassword = $confirmPassword.val().trim();

        const errors = [];

        if (!password) {
          errors.push("Current password is required!");
        } else if (password.length < 6) {
          errors.push("Current password must be at least 6 characters.");
        }

        if (!newPassword) {
          errors.push("New password is required!");
        } else if (newPassword.length < 6) {
          errors.push("New password must be at least 6 characters.");
        }

        if (!confirmPassword) {
          errors.push("Confirm password is required!");
        } else if (confirmPassword.length < 6) {
          errors.push("Confirm password must be at least 6 characters.");
        }

        if (newPassword !== confirmPassword) {
          errors.push("New password and confirm password do not match.");
        }

        updatePassword(errors, password, newPassword);
      });

      function updatePassword(errors, password, newPassword) {
        if (errors.length > 0) {
          $f7.dialog.alert(errors.join("<br>"), "Validation Error");
          return;
        }

        // Simulate a successful password update (you can replace with API call)
        console.log("Password updated successfully");

        $f7.dialog.alert("Password is updated!", "Success");

        // Optionally clear fields
        $currentPassword.val("");
        $newPassword.val("");
        $confirmPassword.val("");
      }
    });

    return $render;
  };
</script>

<style>
  .form__settings {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .form__settings .item-content {
    width: 100%;
  }

  .button-upload {
    margin-top: 10px;
    background-color: #007bff;
    color: white;
    width: 200px;
  }
</style>

<template>
  <div class="page">
    <div class="page-content">
      <div class="block grid grid-gap mt-50">
        <img src="../assets/assets/images/logo1.png" width="150px" class="logo" />
      </div>
      <!-- <div class="block">
        <a href="/login/" class="button button-fill login-button">Login</a>
        <br />
        <a href="/register/" class="link">Register</a>
      </div> -->
    </div>
  </div>
</template>
<style>
  .block {
    text-align: center;
  }

  .mt-50 {
    margin-top: 50%;
    margin-bottom: 30%;
  }
  .logo {
    margin: 0 auto;
  }
  .login-button {
    border-radius: 5px;
    max-width: 150px;
    margin: 0 auto;
  }
</style>
<script>
  export default (props, { $on, $f7router }) => {
    $on("pageInit", () => {
      const userVerify = localStorage.getItem("userVerify");
      const candidate = localStorage.getItem("candidatProfile");
      const user = JSON.parse(localStorage.getItem("user"));
      const token = localStorage.getItem("jwt_token");
      setTimeout(() => {
        if (!userVerify || !token) {
          $f7router.navigate("/login/", { reloadCurrent: true });
        }
        if (userVerify === "0") {
          localStorage.setItem("userVerify", 0);
          fetch(`https://fluffycave.nl/api/verify-user/${user?.id}/resend-code`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email: user.email })
          });
          $f7router.navigate("/verify/", { reloadCurrent: true });
        } else if (user === "0") {
          $f7router.navigate("/profile/", { reloadCurrent: true });
        } else {
          $f7router.navigate("/main/", { reloadCurrent: true });
        }
      }, 2000); // 2 seconds delay
    });

    return $render;
  };
</script>
